---
import { u } from "../../lib/url";
import Base from "../../layouts/Base.astro";
import experiments from "../../data/experiments.json";

// One static page per experiment, so the full write-ups are crawlable without JavaScript.
// The grid on /experiments/ links here and opens the same content in a dialog when it can.
export function getStaticPaths() {
  return experiments.map((e, i) => ({
    params: { slug: e.slug },
    props: {
      e,
      prev: experiments[(i - 1 + experiments.length) % experiments.length],
      next: experiments[(i + 1) % experiments.length],
    },
  }));
}
const { e, prev, next } = Astro.props;

// Base appends " — Pete Woodbridge" (18 characters); keep the whole title within 62.
// An entry can set its own seoTitle, e.g. to stop it competing with a work page of the same name.
const TITLE_MAX = 44;
const rawTitle = e.seoTitle ?? e.title;
const title = rawTitle.length <= TITLE_MAX ? rawTitle : `${rawTitle.slice(0, TITLE_MAX - 1).replace(/\s+\S*$/, "")}…`;

// The data mixes "Prototypes,2023" and "Prototypes, 2023"; show them one way.
const meta = e.meta?.replace(/\s*,\s*/g, ", ").trim() ?? "";
const eyebrow = e.year && !meta.includes(e.year) ? [meta, e.year].filter(Boolean).join(" · ") : meta;

// Meta description: the entry's own description if it has one (for blurbs too thin to stand
// alone), else the blurb plus a short tail when it fits, otherwise the blurb cut at a word.
const MAX = 158;
const blurb = e.blurb ? (/[.!?]$/.test(e.blurb) ? e.blurb : `${e.blurb}.`) : "";
const tail = `${blurb ? " " : ""}An experiment by Pete Woodbridge${e.year ? `, ${e.year}` : ""}.`;
const description =
  e.description ??
  (blurb.length + tail.length <= MAX ? blurb + tail : `${blurb.slice(0, MAX - 1).replace(/\s+\S*$/, "")}…`);

// The poster where there is one, otherwise the still. Seo and the schema pass these through u() themselves.
const image = e.poster ?? e.image ?? e.thumb ?? "/img/og/experiments.jpg";
const pageUrl = `/experiments/${e.slug}`;
// The write-ups use h4 for their few subheadings; under this page's h1 they become h2.
const html = e.html?.replace(/<(\/?)h4\b/g, "<$1h2") ?? "";

const schema = [
  {
    "@type": "CreativeWork",
    "@id": `${pageUrl}#work`,
    url: pageUrl,
    name: e.title,
    ...(e.blurb ? { description: e.blurb } : {}),
    image,
    ...(e.year ? { dateCreated: e.year.match(/\d{4}/)?.[0] ?? e.year } : {}),
    creator: { "@id": "#pete" },
    author: { "@id": "#pete" },
    inLanguage: "en-GB",
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "/" },
      { "@type": "ListItem", position: 2, name: "Experiments", item: "/experiments" },
      { "@type": "ListItem", position: 3, name: e.title, item: pageUrl },
    ],
  },
];
---
<Base title={title} description={description} image={image} imageAlt={e.title} type="article" schema={schema}>
  <section class="xpage">
    <div class="container">
      <p class="eyebrow"><a href={u("/experiments")}>Experiments</a>{eyebrow && ` · ${eyebrow}`}</p>
      <h1 class="display h-lg">{e.title}</h1>
      {e.blurb && <p class="lead measure xpage__lead">{e.blurb}</p>}
    </div>
  </section>

  <section class="section section--tight">
    <div class="container xpage__grid">
      <div class="xpage__media">
        {e.video
          ? <video muted playsinline controls preload="none" poster={e.poster ? u(e.poster) : undefined} src={u(e.video)} aria-label={e.title}></video>
          : <img src={u(e.image ?? e.thumb ?? "")} alt="" decoding="async" />}
      </div>
      <div class="xpage__body">
        {html && <div class="prose" set:html={html} />}
        {e.external && <p class="xpage__ext"><a class="btn btn--volt" href={e.external} target="_blank" rel="noopener">Open {e.title} <span class="arrow" aria-hidden="true">↗</span></a></p>}
        {e.links.length > 0 && (
          <div class="xpage__links">
            <h2 class="xpage__h2">Links</h2>
            <ul class="linklist">
              {e.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}
            </ul>
          </div>
        )}
        <p class="xpage__back"><a class="btn btn--ghost" href={u(`/experiments/#${e.slug}`)}><span aria-hidden="true">←</span> Back to all experiments</a></p>
      </div>
    </div>
  </section>

  <nav class="pager" aria-label="More experiments">
    <a href={u(`/experiments/${prev.slug}`)}><span class="pager__label">Previous</span><span class="pager__title">{prev.title}</span></a>
    <a href={u(`/experiments/${next.slug}`)}><span class="pager__label">Next</span><span class="pager__title">{next.title}</span></a>
  </nav>
</Base>

<style>
  .xpage { padding: 150px 0 0; }
  .xpage .eyebrow a { text-decoration: underline; text-underline-offset: 0.2em; }
  .xpage__lead { margin-top: 1.4rem; }
  .xpage__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  @media (max-width: 900px) { .xpage__grid { grid-template-columns: 1fr; } }
  .xpage__media { background: #000; border-radius: 10px; overflow: hidden; }
  .xpage__media video, .xpage__media img { display: block; width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .xpage__body .prose :global(h2), .xpage__h2 { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; text-transform: uppercase; letter-spacing: -0.02em; margin: 1.2em 0 0.4em; }
  .xpage__h2 { color: var(--volt); }
  .xpage__ext, .xpage__links, .xpage__back { margin-top: 1.5rem; }
  .xpage__links .linklist { columns: 1; }
</style>
