---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import pressData from "../data/press.json";
import { site } from "../data/site";

/**
 * Linked from the About menu. Coverage, interviews and mentions, most notable first.
 * The Economist and Fast Company always lead; everything else keeps its order in press.json.
 */
const featured = ["economist.com", "fastcompany.com"];
const rank = (item: (typeof pressData)[number]) => {
  const i = featured.findIndex((f) => item.links.some((l) => l.url.includes(f)));
  return i === -1 ? featured.length : i;
};
const press = [...pressData].sort((a, b) => rank(a) - rank(b));
const totalLinks = press.reduce((n, item) => n + item.links.length, 0);
// Dead links point at a Wayback Machine snapshot; show (and count) the original outlet, not archive.org.
const archived = (url: string) => /^https:\/\/web\.archive\.org\/web\/\d+\//.test(url);
const host = (url: string) => new URL(url.replace(/^https:\/\/web\.archive\.org\/web\/\d+\//, "")).hostname.replace(/^www\./, "");
const outlets = new Set(press.flatMap((i) => i.links.map((l) => host(l.url))));

// The coverage as a list search engines can read: each entry named by its text, linked to its first link.
const description = `Press coverage and interviews with Pete Woodbridge: ${press.length} entries across ${outlets.size} outlets, from The Economist and Fast Company to the BBC.`;
const schema = [
  {
    "@type": "CollectionPage",
    "@id": "/press#page",
    url: "/press",
    name: "Press and interviews: Pete Woodbridge",
    description,
    about: { "@id": "#pete" },
    inLanguage: "en-GB",
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: press.length,
      itemListElement: press.map((item, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: item.text,
        ...(item.links[0] ? { url: item.links[0].url } : {}),
      })),
    },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "/" },
      { "@type": "ListItem", position: 2, name: "Press", item: "/press" },
    ],
  },
];
---
<Base
  title="Press & Interviews"
  description={description}
  image="/img/og/press.jpg"
  schema={schema}
>
  <section class="phead">
    <div class="container">
      <p class="eyebrow">Coverage &amp; interviews</p>
      <h1 class="display h-lg">Press</h1>
      <p class="lead muted measure" style="margin-top:1rem">
        Most notable first. For comment on AI and the creative economy, <a href={site.linkedin} target="_blank" rel="noopener" style="text-decoration:underline">message me on LinkedIn</a>.
      </p>
      <p class="muted" style="margin-top:0.6rem; font-size:0.9rem">{press.length} entries, {totalLinks} links, {outlets.size} outlets.</p>
    </div>
  </section>

  <section class="section section--tight section--line">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">Short bio</p>
        <h2 class="display h-sm">For programmes and press</h2>
      </div>
      <div class="prose" data-reveal>
        <p>{site.shortBio}</p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <ol class="press">
        {press.map((item, i) => (
          <li class="press__item">
            <span class="press__num">{String(i + 1).padStart(2, "0")}</span>
            <div class="press__body">
              <p class="press__text">{item.text}</p>
              {item.links.length > 0 && (
                <ul class="press__links">
                  {item.links.map((l) => (
                    <li>
                      <a href={l.url} target="_blank" rel="noopener">
                        {l.label}
                        <span class="press__host">{host(l.url)}{archived(l.url) && " · archived"}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            {item.year && <span class="press__year">{item.year}</span>}
          </li>
        ))}
      </ol>
      <p class="lead" style="margin-top:3rem">
        Need a speaker or a comment? See <a href={u("/speaking")} style="text-decoration:underline">talks and panels</a>, or <a href={u("/contact")} style="text-decoration:underline">get in touch</a>.
      </p>
      <p class="muted" style="margin-top:1.4rem; font-size:0.9rem">
        Some of the older links have rotted. Where the Internet Archive kept a copy, the link goes there; where it did not, the entry stays as a record of what was published and where.
      </p>
    </div>
  </section>
</Base>

<style>
  .phead { padding: 150px 0 clamp(24px, 3vw, 40px); }
  .press { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .press__item {
    display: grid; grid-template-columns: 52px 1fr 72px; gap: 20px;
    padding: 26px 0; border-bottom: 1px solid var(--line); align-items: start;
  }
  .press__num { font-family: var(--font-display); font-weight: 800; font-size: 0.85rem; color: var(--muted); padding-top: 4px; }
  .press__text { margin: 0 0 12px; font-size: 1.05rem; line-height: 1.5; max-width: 70ch; overflow-wrap: anywhere; }
  .press__links { display: flex; flex-wrap: wrap; gap: 8px; min-width: 0; }
  .press__links a {
    display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; min-height: 44px;
    max-width: 100%; min-width: 0; overflow-wrap: anywhere;
    padding: 0.45em 0.9em; border: 1px solid var(--line); border-radius: 999px;
    font-size: 0.88rem; font-weight: 600; transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  @media (hover: hover) { .press__links a:hover { border-color: var(--volt); color: var(--volt); } .press__links a:hover .press__host { color: inherit; } }
  .press__host { font-weight: 400; font-size: 0.78rem; color: var(--muted); }
  .press__year { font-family: var(--font-display); font-weight: 700; font-size: 0.85rem; color: var(--volt); text-align: right; padding-top: 4px; }
  @media (max-width: 700px) {
    .press__item { grid-template-columns: 1fr; gap: 8px; }
    .press__num, .press__year { padding-top: 0; text-align: left; }
  }
</style>
