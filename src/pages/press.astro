---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import press from "../data/press.json";

/**
 * Linked from the About menu. Coverage, interviews and mentions, newest first.
 */
const totalLinks = press.reduce((n, item) => n + item.links.length, 0);
// Dead links point at a Wayback Machine snapshot; show (and count) the original outlet, not archive.org.
const archived = (url: string) => /^https:\/\/web\.archive\.org\/web\/\d+\//.test(url);
const host = (url: string) => new URL(url.replace(/^https:\/\/web\.archive\.org\/web\/\d+\//, "")).hostname.replace(/^www\./, "");
const outlets = new Set(press.flatMap((i) => i.links.map((l) => host(l.url))));
---
<Base
  title="Press & Interviews"
  description={`Press coverage and interviews with Pete Woodbridge: ${press.length} entries across ${outlets.size} outlets, from The Economist and Fast Company to the BBC.`}
  image="/img/og/press.jpg"
>
  <section class="phead">
    <div class="container">
      <p class="eyebrow">Coverage &amp; interviews</p>
      <h1 class="display h-lg">Press</h1>
      <p class="lead muted measure" style="margin-top:1rem">
        Coverage, interviews and mentions, newest first.
        {press.length} entries, {totalLinks} links, {outlets.size} outlets.
      </p>
      <p class="muted" style="margin-top:1rem; font-size:0.9rem">
        Some of the older links have rotted. Where the Internet Archive kept a copy, the link goes there; where it did not, the entry stays as a record of what was published and where.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <ol class="press">
        {press.map((item, i) => (
          <li class="press__item">
            <span class="press__num">{String(i + 1).padStart(2, "0")}</span>
            <div class="press__body">
              <p class="press__text">{item.text}</p>
              {item.links.length > 0 && (
                <ul class="press__links">
                  {item.links.map((l) => (
                    <li>
                      <a href={l.url} target="_blank" rel="noopener">
                        {l.label}
                        <span class="press__host">{host(l.url)}{archived(l.url) && " · archived"}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            {item.year && <span class="press__year">{item.year}</span>}
          </li>
        ))}
      </ol>
      <p class="muted" style="margin-top:3rem">
        <a href={u("/work")} style="text-decoration:underline">Back to the work</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .phead { padding: 150px 0 clamp(24px, 3vw, 40px); }
  .press { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .press__item {
    display: grid; grid-template-columns: 52px 1fr 72px; gap: 20px;
    padding: 26px 0; border-bottom: 1px solid var(--line); align-items: start;
  }
  .press__num { font-family: var(--font-display); font-weight: 800; font-size: 0.85rem; color: var(--muted); padding-top: 4px; }
  .press__text { margin: 0 0 12px; font-size: 1.05rem; line-height: 1.5; max-width: 70ch; overflow-wrap: anywhere; }
  .press__links { display: flex; flex-wrap: wrap; gap: 8px; min-width: 0; }
  .press__links a {
    display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; min-height: 44px;
    max-width: 100%; min-width: 0; overflow-wrap: anywhere;
    padding: 0.45em 0.9em; border: 1px solid var(--line); border-radius: 999px;
    font-size: 0.88rem; font-weight: 600; transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .press__links a:hover { border-color: var(--volt); color: var(--volt); }
  .press__host { font-weight: 400; font-size: 0.78rem; color: var(--muted); }
  .press__links a:hover .press__host { color: inherit; }
  .press__year { font-family: var(--font-display); font-weight: 700; font-size: 0.85rem; color: var(--volt); text-align: right; padding-top: 4px; }
  @media (max-width: 700px) {
    .press__item { grid-template-columns: 1fr; gap: 8px; }
    .press__num, .press__year { padding-top: 0; text-align: left; }
  }
</style>
