---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import VideoBg from "../components/VideoBg.astro";
import speaking from "../data/speaking.json";
import { site } from "../data/site";

// newest first, grouped by year
const years = [...new Set(speaking.map((s) => s.year))].filter(Boolean).sort().reverse();
const byYear = years.map((y) => ({ year: y, items: speaking.filter((s) => s.year === y) }));
const undated = speaking.filter((s) => !s.year);

// Topics are drawn from the talks listed below; keep them to what the list actually shows.
const topics = [
  { t: "AI and the next creative economy", d: "The thread through Dream Machine, and through talks from Beyond Conference to Sound City" },
  { t: "Creative AI and AI in music", d: "Creativity + AI: Music at Creative Manchester; Technology, AI and Music at Modern Music Cities" },
  { t: "Practical AI", d: "Practical AI in Action, a workshop at Beyond Conference" },
  { t: "AI and copyright", d: "Copyright and AI panel at the Innovate UK BridgeAI Annual Showcase" },
  { t: "AI, spatial computing and realtime", d: "When Spatial Meets AI at ARVR Innovate, Dublin; AI and realtime convergence at Modern Audiences Conference" },
  { t: "Virtual production and digital puppetry", d: "Virtual Production: State of the Art in Liverpool; digital puppetry at Manchester Animation Festival" },
  { t: "Immersive technology and storytelling", d: "Immersive and AR storytelling talks at ARVR Innovate, Laval Virtual and the Northern Media Summit" },
  { t: "Music tech beyond the capital", d: "Beyond the Capital at Sound City; Write the Future: Music and Technology Conference" },
  { t: "Innovation in the media industries", d: "Panel at Prolific North's Digital Cities Festival" },
];

// Answer first, in plain words: search engines and AI assistants quote these, and they feed the FAQPage data below.
const faqs = [
  {
    q: "Is Pete Woodbridge available as a keynote speaker on creative AI?",
    a: "Yes. Pete Woodbridge is a Liverpool-based speaker on creative AI, virtual production and immersive technology, and gives keynotes, panel talks and practical workshops at national and international conferences. LinkedIn is the quickest way to get in touch.",
  },
  {
    q: "What does he speak about?",
    a: "AI and the next creative economy, creative AI and AI in music, practical AI for creative teams, AI and copyright, virtual production, immersive technology and storytelling, and how innovation actually gets done in the media and music industries.",
  },
  {
    q: "Where has he spoken recently?",
    a: "Recent appearances include Sound City Conference, Creativity + AI: Music at the University of Manchester, Beyond Conference, Manchester Animation Festival, the Innovate UK BridgeAI Annual Showcase and ARVR Innovate in Dublin. The full list is on this page.",
  },
  {
    q: "Does he run workshops and chair panels as well as giving talks?",
    a: "Yes. He runs practical workshops, such as Practical AI in Action at Beyond Conference and a digital puppetry workshop at Manchester Animation Festival, and has organised and chaired panels including Virtual Production: State of the Art in Liverpool.",
  },
];

const schema = [
  {
    "@type": "CollectionPage",
    name: "Speaking by Pete Woodbridge",
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: speaking.length,
      itemListElement: speaking.slice(0, 40).map((s, i) => ({
        "@type": "ListItem", position: i + 1, name: s.text.slice(0, 110),
      })),
    },
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---
<Base
  title="AI & Virtual Production Speaker"
  description="Talks, panels, keynotes and workshops by Pete Woodbridge on AI and the creative economy, creative AI, virtual production and immersive technology."
  image="/img/og/speaking.jpg"
  schema={schema}
>
  <section class="hero hero--short">
    <VideoBg src={u("/video/speaking.mp4")} poster={u("/video/speaking.jpg")} soft />
    <div class="container hero__inner">
      <p class="eyebrow">Speaking</p>
      <h1 class="display h-xl">Talks, panels &amp; workshops</h1>
      <p class="hero__sub">Talks, panels and workshops at national and international conferences, on AI and the creative economy, virtual production, immersive technology and how innovation actually gets done.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p class="lead measure" data-reveal>
        I talk about what AI is actually doing to film, music, games and media, and how to make people better at their work with it, never redundant. I write <a href={u("/work/dream-machine")} style="text-decoration:underline">Dream Machine</a>, cited by The Economist and Fast Company.
      </p>
      <p class="muted measure" data-reveal style="margin-top:1rem">
        Recent stages include Sound City, Beyond Conference, Manchester Animation Festival and ARVR Innovate in Dublin.
      </p>
    </div>
  </section>

  <section class="section section--tight section--line">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">Short bio</p>
        <h2 class="display h-sm">For programmes and press</h2>
      </div>
      <div class="prose" data-reveal>
        <p>{site.shortBio}</p>
      </div>
    </div>
  </section>

  <section class="section section--tight section--line">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">Topics</p>
        <h2 class="display h-md">What I talk about.</h2>
      </div>
      <ul class="topics" data-reveal>
        {topics.map((t) => (
          <li><strong>{t.t}</strong><span class="muted">{t.d}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      {byYear.map((group) => (
        <div class="yr" data-reveal>
          <h2 class="yr__year display">{group.year}</h2>
          <ul class="yr__list">
            {group.items.map((item) => (
              <li class="talk">
                <p class="talk__text">{item.text}</p>
                {item.links.length > 0 && (
                  <p class="talk__links">
                    {item.links.map((l) => (
                      <a href={l.url} target="_blank" rel="noopener">{l.label} <span aria-hidden="true">↗</span></a>
                    ))}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
      {undated.length > 0 && (
        <div class="yr" data-reveal>
          <h2 class="yr__year display">Also</h2>
          <ul class="yr__list">
            {undated.map((item) => <li class="talk"><p class="talk__text">{item.text}</p></li>)}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="section section--line">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2 class="display h-md">Questions about speaking.</h2>
      </div>
      <div class="faq" data-reveal>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--line cta">
    <div class="container">
      <h2 class="display h-lg" data-reveal>Need a speaker?</h2>
      <div class="cta__row" data-reveal>
        <p class="lead measure muted">Conferences, panels, workshops and teaching. I am happiest when it is practical and there is something to argue about.</p>
        <a class="btn btn--volt" href={u("/contact")}>Pitch me a talk <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .yr { display: grid; grid-template-columns: 120px 1fr; gap: clamp(16px, 3vw, 48px); padding: 28px 0; border-top: 1px solid var(--line); }
  .yr__year { font-size: clamp(1.6rem, 3vw, 2.6rem); color: var(--volt); line-height: 1; }
  .yr__list { display: flex; flex-direction: column; gap: 22px; }
  .talk__text { margin: 0; font-size: 1.05rem; line-height: 1.5; max-width: 72ch; }
  .talk__links { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 0; }
  .talk__links a {
    font-size: 0.84rem; font-weight: 600; padding: 0.42em 0.9em; min-height: 44px; display: inline-flex; align-items: center;
    border: 1px solid var(--line); border-radius: 999px; transition: border-color 0.2s, color 0.2s;
  }
  .talk__links a:hover { border-color: var(--volt); color: var(--volt); }
  @media (max-width: 700px) { .yr { grid-template-columns: 1fr; gap: 12px; } }
  .topics { border-top: 1px solid var(--line); }
  .topics li { display: flex; flex-direction: column; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .topics strong { font-weight: 700; }
  .topics span { font-size: 0.95rem; line-height: 1.45; }
</style>
