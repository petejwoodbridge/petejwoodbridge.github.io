---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import VideoBg from "../components/VideoBg.astro";
import { academicRoles, visitingRoles, credentials } from "../data/teaching";

const subjects = [
  // what I am mostly asked for now, first
  "Creative AI", "AI agents & agentic workflows", "Software prototyping", "AI-augmented production workflows",
  "Tool-building (Python, ComfyUI, APIs)", "Interactive programming", "AI & creative software development",
  // and the craft it sits on top of
  "Virtual production (mocap & ICVFX)", "Unreal Engine", "Immersive tech (games, VR/AR)", "Motion capture",
  "Advanced media production", "Film production", "Installation & live event tech", "Notch & Disguise",
  "Motion graphics", "Multicamera production", "Sound & music design", "Sensor-based media arts",
  "Digital media & culture",
];

const places = academicRoles;
const visiting = visitingRoles;

// People find this page by searching for a guest lecturer, a visiting lecturer or someone to design
// a course in creative AI or creative technology. The FAQ answers those searches in plain words;
// search engines and AI assistants quote it, and it feeds the FAQPage structured data below.
const faqs = [
  {
    q: "Who is Pete Woodbridge as an educator?",
    a: "Pete Woodbridge is a lecturer, curriculum designer and visiting lecturer in creative AI and creative technology, based in Liverpool. He built and led the world's first MA Immersive Arts at Liverpool John Moores University, was Senior Lecturer and curriculum development lead for Manchester's £35m School of Digital Arts, and taught at Coventry. He is a Fellow of the Higher Education Academy and of the Royal Society of Arts.",
  },
  {
    q: "What does Pete Woodbridge teach?",
    a: "Mostly creative AI, AI agents and agentic workflows, and software prototyping with Python, ComfyUI and APIs. Underneath that: virtual production, Unreal Engine, motion capture, immersive and interactive technology, and media production.",
  },
  {
    q: "Which universities has he lectured at?",
    a: "As staff: Liverpool John Moores University, Manchester Metropolitan University and Coventry University. As a visiting lecturer: the University of Manchester, the University of Warwick, Zhejiang University of Media and Communications in China, Stellenbosch University in South Africa and the University of Ibadan in Nigeria.",
  },
  {
    q: "What courses and curriculum has he designed?",
    a: "The world's first MA Immersive Arts at LJMU (2018), curriculum for Manchester's School of Digital Arts, a pioneering BA in Digital Media at Coventry, industry bootcamps in games technology for HOST in Salford, and bootcamp curriculum for In4 Group. He has also consulted for Nottingham Trent University on new creative technology degrees.",
  },
  {
    q: "Has he mentored on international programmes?",
    a: "Yes. He has mentored on the Ithra Creative Solutions residency programme in Saudi Arabia and on the Raindance postgraduate degree in film in London.",
  },
  {
    q: "Is he available for guest lectures, workshops or curriculum design?",
    a: "Yes. Guest lectures, workshops, industry training and curriculum design in creative AI, agentic workflows, software prototyping, virtual production and immersive technology, for universities, colleges and skills providers in the UK and internationally. LinkedIn is the quickest way to get in touch.",
  },
];

const universities = visiting.filter((v) => v.university).map((v) => ({ "@type": "CollegeOrUniversity", name: v.org, ...(v.url ? { url: v.url } : {}) }));
const advisoryOrgs = visiting.filter((v) => !v.university).map((v) => ({ "@type": "Organization", name: v.org, ...(v.url ? { url: v.url } : {}) }));

const schema = [
  {
    "@type": "ProfilePage",
    "@id": "/teaching#page",
    url: "/teaching",
    name: "Pete Woodbridge: creative AI lecturer and curriculum designer",
    about: { "@id": "#pete" },
    mainEntity: { "@id": "#pete" },
    inLanguage: "en-GB",
  },
  // Adds the teaching side to the site-wide Person node; same @id, so search engines merge them.
  {
    "@type": "Person",
    "@id": "#pete",
    hasCredential: credentials.map((name) => ({ "@type": "EducationalOccupationalCredential", name, credentialCategory: "Professional fellowship" })),
    hasOccupation: [
      { "@type": "Occupation", name: "Lecturer in creative technology", skills: subjects.join(", ") },
      { "@type": "Occupation", name: "Curriculum designer" },
      { "@type": "Occupation", name: "Visiting lecturer" },
    ],
    affiliation: [
      { "@type": "CollegeOrUniversity", name: "Liverpool John Moores University", url: "https://www.ljmu.ac.uk/" },
      { "@type": "CollegeOrUniversity", name: "Manchester Metropolitan University", url: "https://www.mmu.ac.uk/" },
      { "@type": "CollegeOrUniversity", name: "Coventry University", url: "https://www.coventry.ac.uk/" },
      ...universities,
      ...advisoryOrgs,
    ],
    makesOffer: { "@type": "Offer", itemOffered: { "@id": "/teaching#service" } },
  },
  {
    "@type": "Service",
    "@id": "/teaching#service",
    name: "Guest lectures, workshops and curriculum design in creative AI and creative technology",
    serviceType: ["Guest lecturing", "Visiting lectureships", "Curriculum design", "Industry training", "Workshops"],
    description: "Guest lectures, workshops, industry training and curriculum design in creative AI, AI agents and agentic workflows, software prototyping, virtual production and immersive technology.",
    provider: { "@id": "#pete" },
    audience: { "@type": "EducationalAudience", educationalRole: "Universities, colleges and skills providers" },
    areaServed: ["United Kingdom", "Worldwide"],
    url: "/teaching",
  },
  {
    "@type": "Course",
    name: "MA Immersive Arts",
    description: "The world's first MA in Immersive Arts, developed and led by Pete Woodbridge at Liverpool Screen School from 2018: virtual production, games engines, immersive and interactive media.",
    provider: { "@type": "CollegeOrUniversity", name: "Liverpool John Moores University", url: "https://www.ljmu.ac.uk/" },
    creator: { "@id": "#pete" },
    dateCreated: "2018",
    educationalCredentialAwarded: "MA",
    url: "/work/xlab-ljmu",
  },
  {
    "@type": "Course",
    name: "Industry bootcamps in games technology",
    description: "Industry bootcamps bringing Unreal Engine and realtime talent into the games and creative industries, with curriculum by Pete Woodbridge.",
    provider: { "@type": "Organization", name: "HOST Salford", url: "https://www.hostsalford.com/services/gametech/" },
    creator: { "@id": "#pete" },
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "/" },
      { "@type": "ListItem", position: 2, name: "Teaching", item: "/teaching" },
    ],
  },
];
---
<Base
  title="Creative AI Lecturer & Curriculum Designer"
  description="Creative AI lecturer and curriculum designer. Built the world's first MA Immersive Arts; visiting lecturer at Manchester, Warwick, Stellenbosch and Zhejiang."
  image="/img/og/teaching.jpg"
  imageAlt="Pete Woodbridge, creative AI lecturer and curriculum designer"
  type="profile"
  schema={schema}
>
  <section class="hero hero--short">
    <VideoBg src={u("/video/teaching.mp4")} poster={u("/video/teaching.jpg")} soft />
    <div class="container hero__inner">
      <h1 class="eyebrow">Creative AI lecturer &amp; curriculum designer</h1>
      <p class="display h-xl" style="margin:0">Teaching the next lot</p>
      <p class="hero__sub">Creative AI, agentic workflows and software prototyping, on top of twenty years of production craft. Around eight years of teaching it, and building the courses that did not exist yet.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="lead">Most of what I am asked to teach now is AI, agents and prototyping. The interesting part is that it only works if you understand the craft underneath it.</p>
      </div>
      <div class="prose" data-reveal>
        <p>These days that mostly means creative AI, agentic workflows and software prototyping: building agents and tools that do real work, wiring them into production with Python, ComfyUI and APIs, and getting people to the point where they can prototype an idea themselves in an afternoon. I also run <a href={u("/ai")}>AI training and workshops</a> for businesses and teams. It is the same job I have always done, which is creating industry-focused courses in the places where teaching has not caught up with the tools yet.</p>
        <p>In 2018 I developed and taught the world's first <a href={u("/work/xlab-ljmu")}>MA Immersive Arts</a> at LJMU's Liverpool Screen School, alongside directing the Experimental Technologies Lab. Before that I was Senior Lecturer at Manchester School of Art, leading creative technology across several degrees, and curriculum development lead during the bid and formation of the <a href={u("/work/soda")}>School of Digital Arts</a>. Earlier still, at <a href={u("/work/disruptive-media")}>Coventry</a>, I taught on the Digital Media and Culture MA and the Media Production BA, and built a pioneering BA in Digital Media along with several award-winning open education products.</p>
        <p>Elsewhere I have been curriculum advisor for HOST in Salford, setting up <a href="https://www.hostsalford.com/services/gametech/" target="_blank" rel="noopener">industry bootcamps in games technology</a> to bring more Unreal and realtime talent into the industry, designed bootcamp curriculum for In4 Group, and consulted for Nottingham Trent University on new creative technology degrees. I have mentored projects and people on the <a href="https://www.ithra.com/en/special-programs/The-Creative-Solutions-Residency-Program/cycle-3" target="_blank" rel="noopener">Ithra Creative Solutions</a> programme in Saudi Arabia and the <a href="https://www.raindance.org/postgraduate/" target="_blank" rel="noopener">Raindance postgraduate degree in film</a>.</p>
        <p>Over the years I have been an invited lecturer at the University of Manchester, the University of Warwick, Zhejiang University of Media and Communications in China, the University of Ibadan in Nigeria and Stellenbosch University in South Africa, and worked on digital learning projects for organisations including the BBC, Avid and HEFCE. I am a Fellow of the Higher Education Academy and of the Royal Society of Arts, and I also give <a href={u("/speaking")}>talks and keynotes</a> on AI, virtual production and innovation.</p>
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="container">
      <p class="eyebrow" data-reveal>Where</p>
      <h2 class="display h-lg" data-reveal style="margin-bottom: clamp(24px,3vw,48px)">Academic roles</h2>
      <div class="timeline" data-reveal>
        {places.map((t) => (
          <div class="tl">
            <div class="tl__when">{t.when}</div>
            <div class="tl__role">{t.what}</div>
            <div class="tl__org"><a href={t.url} target="_blank" rel="noopener">{t.where} <span aria-hidden="true">↗</span></a></div>
          </div>
        ))}
      </div>
      <h3 class="display h-md" data-reveal style="margin: clamp(40px,5vw,72px) 0 clamp(20px,2.4vw,36px)">Visiting lectureships and advisory roles</h3>
      <div class="timeline" data-reveal>
        {visiting.map((t) => (
          <div class="tl">
            <div class="tl__when">{t.kind}</div>
            <div class="tl__role">{t.what}</div>
            <div class="tl__org">{t.url ? <a href={t.url} target="_blank" rel="noopener">{t.where} <span aria-hidden="true">↗</span></a> : t.where}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section inverted">
    <div class="container">
      <p class="eyebrow" data-reveal>Subjects</p>
      <h2 class="display h-md" data-reveal style="margin-bottom:1.4rem">What I teach</h2>
      <p class="muted" data-reveal style="max-width:52ch; margin-bottom:1.6rem">Roughly in the order people ask for it.</p>
      <ul class="skills__list" data-reveal>
        {subjects.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--line">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2 class="display h-md">Questions about teaching.</h2>
      </div>
      <div class="faq" data-reveal>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--line cta">
    <div class="container">
      <h2 class="display h-lg" data-reveal>Need a course building?</h2>
      <div class="cta__row" data-reveal>
        <p class="lead measure muted">Curriculum design, guest lectures, workshops and industry training in creative AI and creative technology.</p>
        <a class="btn btn--volt" href={u("/contact")}>Get in touch <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
