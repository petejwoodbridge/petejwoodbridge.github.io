---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import VideoBg from "../components/VideoBg.astro";
import { site } from "../data/site";

const contactSchema = {
  "@type": "ContactPage",
  name: `Contact ${site.name}`,
  mainEntity: { "@id": "#pete" },
};
---
<Base
  title="Contact"
  description="Get in touch with Pete Woodbridge for commissions, consultancy, R&D collaboration, talks and teaching."
  image="/img/og/contact.jpg"
  schema={contactSchema}
>
  <section class="hero hero--page contact">
    <VideoBg src={u("/video/contact.mp4")} poster={u("/video/contact.jpg")} soft />
    <div class="container hero__inner">
      <p class="eyebrow">Contact</p>
      <h1 class="display h-xl">Let's make the world a bit cooler.</h1>
      <p class="hero__sub">Commissions, consultancy, R&amp;D collaborations, talks, teaching, or an idea you want a second opinion on. LinkedIn is the quickest way to reach me.</p>
      <div class="btn-row hero__actions">
        <a class="btn btn--volt" href={site.linkedin} target="_blank" rel="noopener">Message me on LinkedIn <span class="arrow">↗</span></a>
        {site.email && <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-3" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">Follow</p>
        <h2 class="display h-sm" style="margin-bottom:0.8rem">Dream Machine</h2>
        <p class="muted">Regular notes on what AI is doing to film, music, games and media.</p>
        <ul class="list">
          <li><a href={site.dreamMachine.newsletter} target="_blank" rel="noopener">Newsletter on LinkedIn ↗</a></li>
          <li><a href={site.dreamMachine.podcast} target="_blank" rel="noopener">Podcast on Spotify ↗</a></li>
          <li><a href={site.dreamMachine.book} target="_blank" rel="noopener">The book ↗</a></li>
        </ul>
      </div>
      <div data-reveal>
        <p class="eyebrow">Work with the lab</p>
        <h2 class="display h-sm" style="margin-bottom:0.8rem">Dreamlab</h2>
        <p class="muted">For R&amp;D, prototypes, AI and realtime workflows, and production technology projects, the lab has 40+ experts on hand.</p>
        <ul class="list">
          <li><a href="https://dreamlab.org.uk/contact/" target="_blank" rel="noopener">Contact Dreamlab ↗</a></li>
          <li><a href="https://www.linkedin.com/company/thedreamlabuk/" target="_blank" rel="noopener">Dreamlab on LinkedIn ↗</a></li>
        </ul>
      </div>
      <div data-reveal>
        <p class="eyebrow">Community</p>
        <h2 class="display h-sm" style="margin-bottom:0.8rem">Immersive Liverpool</h2>
        <p class="muted">The immersive and games network for the Liverpool City Region, running since 2018.</p>
        <ul class="list">
          <li><a href="https://www.meetup.com/Immersive-Liverpool/" target="_blank" rel="noopener">Join on Meetup ↗</a></li>
        </ul>
        <p class="muted" style="margin-top:1.6rem">{site.location}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .list { margin-top: 1rem; display: flex; flex-direction: column; gap: 8px; font-weight: 600; }
  .list a:hover { color: var(--volt); }
</style>
