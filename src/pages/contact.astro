---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import VideoBg from "../components/VideoBg.astro";
import { site } from "../data/site";

const contactSchema = {
  "@type": "ContactPage",
  name: `Contact ${site.name}`,
  mainEntity: { "@id": "#pete" },
};
---
<Base
  title="Contact"
  description="Get in touch with Pete Woodbridge in Liverpool for AI consultancy, AI training, software prototyping, commissions, R&D collaboration, talks and teaching."
  image="/img/og/contact.jpg"
  schema={contactSchema}
>
  <section class="hero hero--page contact">
    <VideoBg src={u("/video/contact.mp4")} poster={u("/video/contact.jpg")} soft />
    <div class="container hero__inner">
      <h1 class="eyebrow">Contact Pete Woodbridge</h1>
      <p class="display h-xl" style="margin:0">Got an idea?</p>
      <p class="hero__sub">Talks, panels and press comment on AI and the creative economy; commissions, <a href={u("/ai")}>AI consultancy and training</a>, R&amp;D collaborations and teaching.</p>
      <div class="btn-row hero__actions">
        <a class="btn btn--volt" href={site.linkedin} target="_blank" rel="noopener">Message me on LinkedIn <span class="arrow" aria-hidden="true">↗</span></a>
        {site.email && <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>Three ways to work with me</p>
      <ol class="ways" data-reveal>
        <li>
          <h2 class="display h-sm">AI consultancy, prototyping &amp; training</h2>
          <p class="muted">Find where AI earns its place, build the first useful thing, and train the team to use it. <a href={u("/ai")}>AI consultancy</a></p>
        </li>
        <li>
          <h2 class="display h-sm">Talks, panels &amp; press comment</h2>
          <p class="muted">Keynotes, panels and workshops on AI and the creative economy, and comment for journalists. <a href={u("/speaking")}>Speaking</a></p>
        </li>
        <li>
          <h2 class="display h-sm">Programmes, R&amp;D &amp; curriculum</h2>
          <p class="muted">Innovation programmes, funded R&amp;D, funding bids and course design. <a href={u("/research")}>Programmes</a> · <a href={u("/teaching")}>Teaching</a></p>
        </li>
      </ol>
      <p class="lead" data-reveal style="margin-top:clamp(24px,3vw,40px)">Whichever it is, <a href={site.linkedin} target="_blank" rel="noopener">message me on LinkedIn</a> with a line or two about what you are working on.</p>
    </div>
  </section>

  <section class="section section--line">
    <div class="container grid grid-3" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">Follow</p>
        <h2 class="display h-sm" style="margin-bottom:0.8rem">Dream Machine</h2>
        <p class="muted">Regular notes on what AI is doing to film, music, games and media.</p>
        <ul class="list">
          <li><a href={site.dreamMachine.newsletter} target="_blank" rel="noopener">Newsletter on LinkedIn <span aria-hidden="true">↗</span></a></li>
          <li><a href={site.dreamMachine.podcast} target="_blank" rel="noopener">Podcast on Spotify <span aria-hidden="true">↗</span></a></li>
          <li><a href={site.dreamMachine.book} target="_blank" rel="noopener">The book <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
      <div data-reveal>
        <p class="eyebrow">Work with the lab</p>
        <h2 class="display h-sm" style="margin-bottom:0.8rem">Dreamlab</h2>
        <p class="muted">For R&amp;D, prototypes, AI and realtime workflows, and production technology projects, the lab has 48+ experts on hand.</p>
        <ul class="list">
          <li><a href="https://dreamlab.org.uk/contact/" target="_blank" rel="noopener">Contact Dreamlab <span aria-hidden="true">↗</span></a></li>
          <li><a href="https://www.linkedin.com/company/thedreamlabuk/" target="_blank" rel="noopener">Dreamlab on LinkedIn <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
      <div data-reveal>
        <p class="eyebrow">Community</p>
        <h2 class="display h-sm" style="margin-bottom:0.8rem">Immersive Liverpool</h2>
        <p class="muted">The immersive and games network for the Liverpool City Region, running since 2018.</p>
        <ul class="list">
          <li><a href="https://www.meetup.com/Immersive-Liverpool/" target="_blank" rel="noopener">Join on Meetup <span aria-hidden="true">↗</span></a></li>
        </ul>
        <p class="muted" style="margin-top:1.6rem">{site.location}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .ways { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(18px, 2.5vw, 36px); border-top: 1px solid var(--line); }
  .ways li { padding-top: 24px; }
  .ways h2 { margin-bottom: 0.8rem; }
  .ways p { margin: 0; }
  .ways a { color: var(--ink); text-decoration: underline; font-weight: 600; }
  @media (max-width: 900px) { .ways { grid-template-columns: 1fr; } }
  .list { margin-top: 1rem; display: flex; flex-direction: column; gap: 8px; font-weight: 600; }
  .list a:hover { color: var(--volt); }
</style>
