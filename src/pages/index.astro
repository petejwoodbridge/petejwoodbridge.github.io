---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import VideoBg from "../components/VideoBg.astro";
import Marquee from "../components/Marquee.astro";
import WorkCard from "../components/WorkCard.astro";
import { site } from "../data/site";
import { mainProjects as projects } from "../data/work";

const stats = [
  { num: "20+", label: "years building creative technology: commercial, R&D, future thinking" },
  { num: "£12m", label: "of innovation programmes + projects developed and led" },
  { num: "50+", label: "funded R&D and innovation collaborations across all programmes" },
  { num: "100+", label: "businesses and freelancers supported by Dreamlab since 2024" },
];
const pillars = [
  { t: "AI & realtime", d: "Making people faster, stranger and better at their thing, never redundant. AI-augmented workflows, agentic software development and data engineering, built into tools, platforms and systems people use every day." },
  { t: "Innovation leadership", d: "Turning a region's talent and ideas into projects, products and companies. Programmes, clusters, labs and investment are the means; creating the conditions is the point." },
  { t: "Immersive & live experiences", d: "Giving thousands of people something to feel in the same room at the same time. Projection mapping, tracking, sensors and games engines, for rooms, stages, stadiums and streets." },
  { t: "Virtual production", d: "Putting film-scale production within reach of teams who could never go near a backlot. LED volumes, in-camera VFX, motion capture and volumetric pipelines, from a garage set-up to a 6,000 sq ft stage." },
];

const homeSchema = {
  "@type": "ProfilePage",
  name: `${site.name} — ${site.shortRole}`,
  description: site.description,
  mainEntity: { "@id": "#pete" },
  hasPart: projects.map((p, i) => ({
    "@type": "CreativeWork",
    position: i + 1,
    name: p.title,
    description: p.tagline,
    url: `/work/${p.slug}`,
  })),
};
---
<Base
  description={site.metaDescription ?? site.description}
  image="/img/og/home.jpg"
  schema={homeSchema}
>
  <section class="hero">
    <VideoBg src={u("/video/hero.mp4")} srcSm={u("/video/hero-720.mp4")} poster={u("/video/hero.jpg")} />
    <div class="container hero__inner">
      <h1 class="eyebrow">Pete Woodbridge — AI consultant &amp; creative technologist, Liverpool</h1>
      <p class="display h-xl" style="margin:0">I build things &amp; back <span class="accent">people</span>.</p>
      <div class="hero__meta">
        <div>
          <p class="hero__sub">I help organisations put AI to real work, and I build the programmes, labs and funding that back a region's innovators.</p>
          <div class="btn-row hero__actions">
            <a class="btn btn--volt" href={u("/ai")}>Work with me on AI <span class="arrow" aria-hidden="true">↗</span></a>
            <a class="btn" href={u("/work")}>See the work</a>
          </div>
        </div>
        <span class="hero__scroll">Scroll</span>
      </div>
    </div>
  </section>

  <Marquee />

  <section class="section">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">Now</p>
        <h2 class="display h-md">Digital &amp; Technology Cluster Lead, Liverpool City Region.</h2>
        {site.portrait && (
          <figure class="portrait portrait--home">
            <img src={u(site.portrait)} alt="Pete Woodbridge, creative technologist based in Liverpool" width="400" height="400" loading="lazy" decoding="async" />
          </figure>
        )}
      </div>
      <div class="prose" data-reveal>
        <p>I'm Pete Woodbridge, an AI consultant and creative technologist based in Liverpool. Over twenty years I've worked with the BBC, Aardman, Epic Games and the NHS, among many others.</p>
        <p>The day job is growing the Liverpool City Region's digital and technology sector with its businesses, universities, investors and talent. Alongside it I direct <a href={site.dreamlab} target="_blank" rel="noopener">Dreamlab</a>, an R&amp;D lab and collective of 48+ experts; since 2024 we have helped over 100 businesses and freelancers, among them <a href={u("/work/dreamlab")}>Dock10, Krygon Studios (at the MSG Sphere) and PlayXD (with Meta)</a>. <a href={site.dreamMachine.book} target="_blank" rel="noopener">Dream Machine</a>, my book, <a href={site.dreamMachine.newsletter} target="_blank" rel="noopener">newsletter</a> and <a href={site.dreamMachine.podcast} target="_blank" rel="noopener">podcast</a> on AI and the next creative economy, has been cited by <a href="https://www.economist.com/business/2026/08/04/hollywood-is-entering-its-ai-era" target="_blank" rel="noopener">The Economist</a> and <a href="https://www.fastcompany.com/91568818/our-interest-in-ai-slop-is-hitting-a-ceiling" target="_blank" rel="noopener">Fast Company</a>.</p>
        <p>I still build hands-on: AI tools, prototypes and data platforms like <a href={u("/work/soundings")}>Soundings</a> and <a href={u("/work/bearings")}>Bearings</a>, alongside the regional role.</p>
        <p>Until recently I was R&amp;D and Innovation Lead on <a href={u("/work/musicfutures")}>MusicFutures</a>, a £7.2m programme I helped the region win, and R&amp;D Innovation Director at the <a href={u("/work/mediacity")}>MediaCity Innovation Hub</a>, where we backed 35+ collaborative projects on a £3.2m accelerator.</p>
        <p>Before that came studios, start-ups, universities and brand work: hands-on R&amp;D, development and production. Software, AI and computer vision. Interactive and sensor-based media, projection mapping and live event technology. Games engines, VR/XR and mixed reality, motion and volumetric capture, virtual production and in-camera VFX. I built it in Python, Unreal Engine, Unity, JavaScript and the web, and now mostly with creative AI and agentic workflows.</p>
        <p>One eye always on what's next, technically and strategically. Keep experimenting.</p>
        <div class="btn-row" style="margin-top:1.4rem">
          <a class="btn" href={u("/about")}>More about me</a>
          <a class="btn btn--ghost" href={site.dreamMachine.book} target="_blank" rel="noopener">The book <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <div class="container" style="margin-top:clamp(48px,6vw,96px)">
      <div class="stats stagger" data-reveal>
        {stats.map((s, i) => (
          <div class="stat" style={`--i:${i}`}>
            <div class="stat__num">{s.num}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section inverted">
    <div class="container">
      <p class="eyebrow" data-reveal>What I do</p>
      <h2 class="display h-lg" data-reveal style="max-width: 14ch; margin-bottom: clamp(32px,4vw,64px)">Four things, done properly.</h2>
      <div class="pillars stagger" data-reveal>
        {pillars.map((p, i) => (
          <div class="pillar" style={`--i:${i}`}>
            <div class="pillar__num">0{i + 1}</div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
      <div class="skills" data-reveal>
        <h3 class="skills__title">Things I am asked for</h3>
        <ul class="skills__list">
          {site.expertise.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="btn-row" data-reveal style="margin-top:clamp(28px,3vw,44px)">
        <a class="btn" href={u("/ai")}>AI consultancy, prototyping &amp; training <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section section--line" id="work">
    <div class="container">
      <div class="grid grid-2" style="align-items:end; margin-bottom: clamp(32px,4vw,64px)">
        <div data-reveal>
          <p class="eyebrow">Selected work</p>
          <h2 class="display h-lg">Ten roles, from a £3.2m accelerator to a 6,000 sq ft LED stage</h2>
        </div>
        <p class="lead muted" data-reveal>Labs, stages, programmes and playable things, some of the names involved, and the freelance work running underneath all of it.</p>
      </div>
      <div class="work-grid">
        {projects.map((p, i) => <WorkCard project={p} index={i} />)}
        <a class="card card--lg card--plain" href={u("/about")} data-reveal>
          <div class="card__media card__media--type">
            <span class="card__num">11</span>
            <span class="card__big">2003<span class="card__big-sub">&rarr;</span></span>
          </div>
          <div class="card__body">
            <div class="card__top">
              <h3 class="card__title">Freelance &amp; consultancy<span class="arrow" aria-hidden="true">&#8599;</span></h3>
              <span class="card__when">2003 &ndash; present</span>
            </div>
            <p class="card__tag">Independent work for brands, studios, universities and companies, running underneath every role on this page.</p>
            <p class="card__meta"><span class="card__role">Creative technologist</span></p>
          </div>
        </a>
        <a class="card card--md card--cta" href={u("/contact")} data-reveal>
          <div class="card__media card__media--type">
            <span class="card__num">12</span>
            <span class="card__big card__big--cta">Work<br />with me</span>
          </div>
          <div class="card__body">
            <div class="card__top">
              <h3 class="card__title">Start something<span class="arrow" aria-hidden="true">&#8599;</span></h3>
            </div>
            <p class="card__tag">Commissions, consultancy, R&amp;D collaborations, talks and teaching.</p>
            <p class="card__meta"><span class="card__role">Get in touch</span></p>
          </div>
        </a>
      </div>
      <div style="margin-top:clamp(32px,4vw,56px)">
        <a class="btn" href={u("/work")}>All work <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">Why</p>
        <h2 class="display h-lg" style="max-width:16ch">The technology was never the point.</h2>
      </div>
      <div class="prose" data-reveal>
        <p>I've built immersive rooms, LED stages, games-engine tools, data platforms and AI agents. What kept me interested was never the kit. It was the people using it, and what they made once it stopped getting in the way.</p>
        <p>Which is why the two halves of my work are really one. Hands-on, I build tools, platforms, workflows and systems for the people doing the work. On the other side, I build the programmes, funding and labs that hand the same tools to people who would otherwise never get near them.</p>
      </div>
    </div>
  </section>

  <section class="section section--line cta">
    <div class="container">
      <h2 class="display h-xl" data-reveal>Tell me what you're building.</h2>
      <div class="cta__row" data-reveal>
        <p class="lead measure muted">Commissions, <a href={u("/ai")}>AI consultancy</a>, R&amp;D collaborations, <a href={u("/speaking")}>talks</a>, or just an idea you want to test on someone who has probably tried it once already.</p>
        <a class="btn btn--volt" href={u("/contact")}>Get in touch <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
