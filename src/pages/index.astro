---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import VideoBg from "../components/VideoBg.astro";
import Marquee from "../components/Marquee.astro";
import WorkCard from "../components/WorkCard.astro";
import { site } from "../data/site";
import { mainProjects as projects } from "../data/work";

const stats = [
  { num: "20+", label: "years building creative technology: commercial, R&D, future thinking" },
  { num: "£12m", label: "of innovation programmes developed and led" },
  { num: "50+", label: "funded R&D and innovation collaborations supported" },
  { num: "100+", label: "businesses, agencies and organisations worked with" },
];
const pillars = [
  { t: "Innovation leadership", d: "Turning a region's talent and ideas into real projects, products and companies. Programmes, clusters, labs and investment are the means; creating the conditions is the point." },
  { t: "AI & realtime", d: "Making people faster, stranger and better at their thing, never redundant. AI-augmented workflows, agentic software development and tool-building." },
  { t: "Immersive & live experiences", d: "Giving thousands of people something to feel in the same room at the same time. Projection mapping, tracking, sensors and games engines, for rooms, stages, stadiums and streets." },
  { t: "Virtual production", d: "Putting film-scale production within reach of teams who could never go near a backlot. LED volumes, in-camera VFX, motion capture and volumetric pipelines, from a garage set-up to a 6,000 sq ft stage." },
];

const homeSchema = {
  "@type": "ProfilePage",
  name: `${site.name} — ${site.shortRole}`,
  description: site.description,
  mainEntity: { "@id": "#pete" },
  hasPart: projects.map((p, i) => ({
    "@type": "CreativeWork",
    position: i + 1,
    name: p.title,
    description: p.tagline,
    url: `/work/${p.slug}`,
  })),
};
---
<Base
  image="/img/og/home.jpg"
  schema={homeSchema}
>
  <section class="hero">
    <VideoBg src={u("/video/hero.mp4")} srcSm={u("/video/hero-720.mp4")} poster={u("/video/hero.jpg")} />
    <div class="container hero__inner">
      <p class="eyebrow">Pete Woodbridge · Creative technologist &amp; innovation leader · Liverpool</p>
      <h1 class="display h-xl">Build things. Back people.</h1>
      <div class="hero__meta">
        <div>
          <p class="hero__sub">Creative AI, agentic workflows and software prototyping. Plus the programmes, labs and funding that get other innovators backed.</p>
          <div class="btn-row hero__actions">
            <a class="btn btn--volt" href={u("/work")}>See the work <span class="arrow">↗</span></a>
            <a class="btn" href={u("/about")}>About me</a>
          </div>
        </div>
        <span class="hero__scroll">Scroll</span>
      </div>
    </div>
  </section>

  <Marquee />

  <section class="section">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">Hello</p>
        <p class="lead">I build things out of creativity and technology, and the conditions for other people to build theirs.</p>
        {site.portrait && (
          <figure class="portrait portrait--home">
            <img src={u(site.portrait)} alt="Pete Woodbridge, creative technologist based in Liverpool" width="400" height="400" loading="lazy" decoding="async" />
          </figure>
        )}
      </div>
      <div class="prose" data-reveal>
        <p>I'm Pete Woodbridge, a creative technologist, engineer and innovation leader based in Liverpool.</p>
        <p>I have 20+ years of experience across digital and technology roles, R&amp;D and innovation, and building programmes that help the next generation of innovators and technical talent.</p>
        <p>Working on projects for major brands, artists, labs, studios and other partners — the BBC, ITV, Aardman, Google, Sony, Epic Games, the NHS and the United Nations among them.</p>
        <p>Right now I am the Digital &amp; Technology Cluster Lead for the Liverpool City Region, growing the region's digital and technology sector with its businesses, universities, investors and talent. I also direct <a href={site.dreamlab} target="_blank" rel="noopener">Dreamlab</a>, an R&amp;D lab and collective of 40+ experts, and write <a href={site.dreamMachine.book} target="_blank" rel="noopener">Dream Machine</a>, a living book about AI and the next creative economy.</p>
        <p>Until recently I was R&amp;D and Innovation Lead on <a href={u("/work/musicfutures")}>MusicFutures</a>, a £7.2m programme I helped the region win, and Innovation Director at the <a href={u("/work/mediacity")}>MediaCity Immersive Technologies Innovation Hub</a>, where we backed 35+ collaborative projects on a £3.2m accelerator.</p>
        <p>Before that, I've worked in studios, start-ups and universities, and for brands. Most of my hands-on work now is creative AI, agentic workflows and software prototyping: agents and tools that do real work inside production.</p>
        <p>One eye always on what's next — technically and strategically, for the customer, the people and the opportunity.</p>
      </div>
    </div>
    <div class="container" style="margin-top:clamp(48px,6vw,96px)">
      <div class="stats stagger" data-reveal>
        {stats.map((s, i) => (
          <div class="stat" style={`--i:${i}`}>
            <div class="stat__num">{s.num}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">Why</p>
        <h2 class="display h-lg" style="max-width:16ch">The technology was never the point.</h2>
      </div>
      <div class="prose" data-reveal>
        <p>Every tool I have built — LED stages, projection systems, games engines, now agents — only ever mattered for what someone else could do once it existed. Technology for its own sake has never held me for long. What holds me is the person on the other side of it, who will make something extraordinary the moment the thing in front of them stops getting in the way.</p>
        <p>Which is why the two halves of my work are really one. Hands-on, I build agents and tools that make people faster, stranger and better at their thing, never redundant. On the other side, I build the programmes, funding and labs that put all of that within reach of people who would otherwise never get near it.</p>
      </div>
    </div>
  </section>

  <section class="section section--line" id="work">
    <div class="container">
      <div class="grid grid-2" style="align-items:end; margin-bottom: clamp(32px,4vw,64px)">
        <div data-reveal>
          <p class="eyebrow">Selected work</p>
          <h2 class="display h-lg">Labs, stages, programmes &amp; playable things</h2>
        </div>
        <p class="lead muted" data-reveal>Ten places where the work happened, and some of the names involved. Each one links out to the projects and partners.</p>
      </div>
      <div class="work-grid">
        {projects.map((p, i) => <WorkCard project={p} index={i} />)}
      </div>
      <div style="margin-top:clamp(32px,4vw,56px)">
        <a class="btn" href={u("/work")}>All work <span class="arrow">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section inverted">
    <div class="container">
      <p class="eyebrow" data-reveal>What I do</p>
      <h2 class="display h-lg" data-reveal style="max-width: 14ch; margin-bottom: clamp(32px,4vw,64px)">Four things, done properly.</h2>
      <div class="pillars stagger" data-reveal>
        {pillars.map((p, i) => (
          <div class="pillar" style={`--i:${i}`}>
            <div class="pillar__num">0{i + 1}</div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
      <div class="skills" data-reveal>
        <h3 class="skills__title">Things I am asked for</h3>
        <ul class="skills__list">
          {site.expertise.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container feature">
      <div data-reveal>
        <p class="eyebrow">Now</p>
        <h2 class="display h-md" style="margin-bottom:1.2rem">Digital &amp; Technology Cluster Lead, Liverpool City Region.</h2>
        <div class="prose">
          <p>My newest role, and the clearest version of what I do: working with the region's businesses, universities, investors and talent to grow one of the UK's fastest-moving digital and technology economies. Less about what I build myself, more about what becomes possible for everyone else. It follows the MusicFutures programme and the Immersive Liverpool network I founded in 2018.</p>
          <p>I also direct <a href={site.dreamlab} target="_blank" rel="noopener">Dreamlab</a> and publish <a href={site.dreamMachine.newsletter} target="_blank" rel="noopener">Dream Machine</a>, a newsletter, <a href={site.dreamMachine.podcast} target="_blank" rel="noopener">podcast</a> and book tracking what AI is doing to film, music, games and media. It has been picked up by <a href="https://www.economist.com/business/2026/08/04/hollywood-is-entering-its-ai-era" target="_blank" rel="noopener">The Economist</a> and <a href="https://www.fastcompany.com/91568818/our-interest-in-ai-slop-is-hitting-a-ceiling" target="_blank" rel="noopener">Fast Company</a>.</p>
        </div>
        <div class="btn-row" style="margin-top:1.4rem">
          <a class="btn" href={u("/about")}>More about me</a>
          <a class="btn btn--ghost" href={site.dreamMachine.book} target="_blank" rel="noopener">The book <span class="arrow">↗</span></a>
        </div>
      </div>
      <div class="feature__img" data-reveal>
        <img src={u("/img/dream-machine-book.webp")} alt="Dream Machine: AI and the next creative economy, book and newsletter" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section section--line cta">
    <div class="container">
      <h2 class="display h-xl" data-reveal>Tell me what you're building.</h2>
      <div class="cta__row" data-reveal>
        <p class="lead measure muted">Commissions, consultancy, R&amp;D collaborations, talks, or just an idea you want to test on someone who has probably tried it once already.</p>
        <a class="btn btn--volt" href={u("/contact")}>Get in touch <span class="arrow">↗</span></a>
      </div>
    </div>
  </section>
</Base>
