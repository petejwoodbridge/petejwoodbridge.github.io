---
import { existsSync } from "node:fs";
import { u } from "../../lib/url";
import Base from "../../layouts/Base.astro";
import VideoBg from "../../components/VideoBg.astro";
import { projects, neighbours } from "../../data/work";
import { site } from "../../data/site";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project: p } = Astro.props;
const { prev, next } = neighbours(p.slug);

const years = p.period.match(/\d{4}/g) ?? [];

// Meta description: the tagline plus a short role and date tail, kept within 158 characters.
// If the tail will not fit, the tagline goes alone; a tagline that is itself too long is cut at its
// last clause break (or word) before the limit.
const MAX = 158;
const tagline = /[.!?]$/.test(p.tagline) ? p.tagline : `${p.tagline}.`;
const tail = ` ${p.cardRole ?? p.role}, ${p.period}.`;
const clip = (t: string) => {
  if (t.length <= MAX) return t;
  const cut = t.slice(0, MAX - 1);
  const clause = Math.max(cut.lastIndexOf(", "), cut.lastIndexOf(": "), cut.lastIndexOf("; "));
  return `${cut.slice(0, clause > 100 ? clause : cut.lastIndexOf(" ")).replace(/[\s,;:.–-]+$/, "")}…`;
};
const description = tagline.length + tail.length <= MAX ? tagline + tail : clip(tagline);

// A pointer from each project to the service or page it most relates to.
const academic = ["xlab-ljmu", "soda", "disruptive-media"].includes(p.slug);
const programme = ["musicfutures", "mediacity", "dreamlab"].includes(p.slug);
// Projects where virtual production was part of the job also point at the /virtual-production hub.
const vp = ["pathway", "draw-and-code", "xlab-ljmu", "mediacity", "crucial-fx", "dreamlab"].includes(p.slug);

// The share card where one exists, otherwise the card image.
const image = existsSync(`public/img/og/${p.slug}.jpg`) ? `/img/og/${p.slug}.jpg` : p.card;
const pageUrl = `/work/${p.slug}`;

// Dream Machine is a book, a podcast and a newsletter: give each its own node, linked from the project.
// No datePublished on the book: the site states no publication year for it.
const dm = site.dreamMachine;
const dreamMachineSchema =
  p.slug === "dream-machine"
    ? [
        {
          "@type": "Book",
          "@id": `${pageUrl}#book`,
          name: "Dream Machine: AI and the Next Creative Economy",
          author: { "@id": "#pete" },
          url: dm.book,
          description: p.body[0],
          about: ["Artificial intelligence", "Creative industries", "Creative AI"],
          inLanguage: "en-GB",
          image,
        },
        {
          "@type": "PodcastSeries",
          "@id": `${pageUrl}#podcast`,
          name: "Dream Machine",
          description: "The Dream Machine podcast goes deeper on AI and the creative economy with the people doing the work.",
          author: { "@id": "#pete" },
          url: dm.podcast,
          inLanguage: "en-GB",
        },
        {
          "@type": "CreativeWorkSeries",
          "@id": `${pageUrl}#newsletter`,
          name: "Dream Machine newsletter",
          description: "Regular updates on AI news, tools, trends, research and policy for the creative industries.",
          author: { "@id": "#pete" },
          url: dm.newsletter,
          inLanguage: "en-GB",
        },
      ]
    : [];
const projectSchema = [
  {
    "@type": "CreativeWork",
    "@id": `${pageUrl}#work`,
    url: pageUrl,
    image,
    name: p.title,
    headline: `${p.title} — ${p.role}`,
    description: p.tagline,
    abstract: p.intro,
    ...(years[0] ? { dateCreated: years[0] } : {}),
    creator: { "@id": "#pete" },
    author: { "@id": "#pete" },
    about: p.tags,
    keywords: p.tags.join(", "),
    ...(p.orgUrl
      ? { sourceOrganization: { "@type": "Organization", name: p.org, url: p.orgUrl } }
      : {}),
    ...(p.product
      ? {
          mainEntity: {
            "@type": "WebApplication",
            name: p.product.name,
            url: p.product.url,
            applicationCategory: p.product.category,
            operatingSystem: "Any",
            isAccessibleForFree: true,
            offers: { "@type": "Offer", price: "0", priceCurrency: "GBP" },
            creator: { "@id": "#pete" },
            ...(p.product.areaServed ? { areaServed: p.product.areaServed.map((name) => ({ "@type": "Place", name })) } : {}),
          },
        }
      : {}),
    ...(p.press?.length
      ? { subjectOf: p.press.map((l) => ({ "@type": "NewsArticle", headline: l.label, url: l.url })) }
      : {}),
    ...(dreamMachineSchema.length ? { hasPart: dreamMachineSchema.map((n) => ({ "@id": n["@id"] })) } : {}),
  },
  ...dreamMachineSchema,
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "/" },
      { "@type": "ListItem", position: 2, name: "Work", item: "/work" },
      { "@type": "ListItem", position: 3, name: p.title, item: pageUrl },
    ],
  },
];
---
<Base
  title={p.seoTitle ?? p.title}
  description={description}
  image={image}
  imageAlt={`${p.title} — ${p.tagline}`}
  type="article"
  schema={projectSchema}
>
  {/* Stays on screen while reading. Base.astro points it back at the page the card was opened
       from (Home or Work) and sends it through history, so the hero shrinks back into its card at
       the same scroll position. Escape does the same. Landing here directly, it is a plain link to Work. */}
  <a class="back" href={u("/work/")} data-back><span class="arrow" aria-hidden="true">←</span> <span data-back-label>All work</span></a>

  <section class="hero hero--page">
    {/* Named so a work card's image morphs into this hero on navigation (WorkCard carries the same name). */}
    <div class="hero__media" transition:name={`project-${p.slug}`}>
      <VideoBg src={u(p.video)} poster={u(p.poster)} />
    </div>
    <div class="container hero__inner">
      <p class="eyebrow">{p.org} · {p.period}</p>
      <h1 class="display h-xl">{p.title}</h1>
      <p class="hero__sub">{p.tagline}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <dl class="project-meta" data-reveal>
        <div><dt>Role</dt><dd>{p.role}</dd></div>
        <div><dt>Organisation</dt><dd><a href={p.orgUrl} target="_blank" rel="noopener">{p.org} <span aria-hidden="true">↗</span></a></dd></div>
        <div><dt>When</dt><dd>{p.period}</dd></div>
        <div><dt>Areas</dt><dd class="muted" style="font-weight:500">{p.tags.join(" · ")}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container project-body">
      <aside class="project-body__side" data-reveal>
        <p class="lead">{p.intro}</p>
      </aside>
      <div>
        <div class="prose" data-reveal>
          {p.body.map((html) => <p set:html={html} />)}
          {academic ? (
            <p>Related: my <a href={u("/teaching")}>teaching, lecturing and curriculum design</a>.</p>
          ) : programme ? (
            <p>Related: <a href={u("/research")}>R&amp;D and innovation programmes</a> and how to <a href={u("/contact")}>work with me</a>.</p>
          ) : (
            <p>Related: <a href={u("/ai")}>AI consultancy, prototyping and training</a> in Liverpool and Manchester.</p>
          )}
          {vp && <p>More on <a href={u("/virtual-production")}>virtual production, LED volumes and ICVFX</a> in Manchester and the North West.</p>}
        </div>
        {p.groups?.map((g) => (
          <div class="group" data-reveal>
            <h2 class="display h-sm group__title">{g.title}</h2>
            <ul class="linklist">
              {g.items.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}
            </ul>
          </div>
        ))}
        {p.press && p.press.length > 0 && (
          <div class="group" data-reveal>
            <h2 class="display h-sm group__title">In the press</h2>
            <ul class="linklist">
              {p.press.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  {/* The ending every project shares, worded for the kind of reader each one draws. */}
  <section class="section section--line cta">
    <div class="container">
      <h2 class="display h-lg" data-reveal>Working on something like this?</h2>
      <div class="cta__row" data-reveal>
        <p class="lead measure muted">
          {academic
            ? "Guest lectures, course design or a live brief for students: I'm always glad to hear what you're planning."
            : programme
              ? "A programme, a lab or a funding bid: happy to share what worked here, and what I'd do differently next time."
              : "However early the idea, I'm happy to talk it through. Tell me what you have in mind and where it's stuck."}
        </p>
        <a class="btn btn--volt" href={u("/contact")}>Get in touch <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <nav class="pager" aria-label="More work">
    <a href={u(`/work/${prev.slug}`)}><span class="pager__label">Previous</span><span class="pager__title">{prev.title}</span></a>
    <a href={u(`/work/${next.slug}`)}><span class="pager__label">Next</span><span class="pager__title">{next.title}</span></a>
  </nav>
</Base>

<style>
  /* Fills the hero exactly as the video did on its own, so the named view-transition box has the hero's size. */
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .group { margin-top: clamp(32px, 4vw, 56px); }
  .group__title { margin-bottom: 12px; color: var(--volt); }
</style>
