---
import { u } from "../../lib/url";
import Base from "../../layouts/Base.astro";
import VideoBg from "../../components/VideoBg.astro";
import WorkCard from "../../components/WorkCard.astro";
import Marquee from "../../components/Marquee.astro";
import { site } from "../../data/site";
import { mainProjects, moreProjects } from "../../data/work";
import experiments from "../../data/experiments.json";
const withVideo = experiments.filter((e) => e.video).slice(0, 6);
const all = [...mainProjects, ...moreProjects];

const workSchema = {
  "@type": "CollectionPage",
  name: "Work by Pete Woodbridge",
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: all.length,
    itemListElement: all.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `/work/${p.slug}`,
      name: p.title,
    })),
  },
};
---
<Base
  title="Work"
  description="Selected work by Pete Woodbridge: MusicFutures, Dreamlab, MediaCity, Crucial FX, Pathway Studios, Draw & Code, XLab at LJMU and SODA Manchester, plus books, awards and experiments."
  image="/img/og/work.jpg"
  schema={workSchema}
>
  <section class="hero hero--short">
    <VideoBg src={u("/video/pathway.mp4")} poster={u("/video/pathway.jpg")} soft />
    <div class="container hero__inner">
      <p class="eyebrow">Work</p>
      <h1 class="display h-xl">Labs, stages, programmes &amp; playable things.</h1>
      <p class="hero__sub">Some of the places where the work happened, and the projects, partners and people involved. Freelance, contracts and more.</p>
    </div>
  </section>

  <Marquee items={site.clients} />

  <section class="section">
    <div class="container">
      <div class="work-grid">
        {mainProjects.map((p, i) => <WorkCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="container">
      <div class="grid grid-2" style="align-items:end; margin-bottom: clamp(32px,4vw,64px)">
        <div data-reveal>
          <p class="eyebrow">Also</p>
          <h2 class="display h-lg">Books, awards &amp; side quests</h2>
        </div>
        <p class="lead muted" data-reveal>Things that sit alongside the main roles: a living book about creative AI, a national data project, a mixed-reality football game and a couple of nice awards.</p>
      </div>
      <div class="work-grid work-grid--more">
        {moreProjects.map((p, i) => <WorkCard project={p} index={mainProjects.length + i} size="md" />)}
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="container">
      <div class="grid grid-2" style="align-items:end; margin-bottom: clamp(32px,4vw,64px)">
        <div data-reveal>
          <p class="eyebrow">Experiments</p>
          <h2 class="display h-lg">{experiments.length} more things I made.</h2>
        </div>
        <div data-reveal>
          <p class="lead muted">Prototypes, hacks, residencies, installations, talks and odd ideas from twenty years of trying things. Mostly on video.</p>
          <a class="btn btn--volt" href={u("/experiments")} style="margin-top:1rem">Open the experiments <span class="arrow">↗</span></a>
        </div>
      </div>
      <div class="strip" data-reveal>
        {withVideo.map((e) => (
          <a class="strip__item" href={u(`/experiments#${e.slug}`)} title={e.title}>
            <img src={u(e.thumb ?? e.poster)} alt={e.title} loading="lazy" />
            <span>{e.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .work-grid--more :global(.card--md) { grid-column: span 12; }
  @media (min-width: 1100px) { .work-grid--more :global(.card--md) { grid-column: span 3; } }
  @media (min-width: 700px) and (max-width: 1099px) { .work-grid--more :global(.card--md) { grid-column: span 6; } }
  .work-grid--more :global(.card__media) { aspect-ratio: 4 / 3; }
  .work-grid--more :global(.card__title) { font-size: clamp(1.3rem, 1.6vw, 1.6rem); }
  .strip { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .strip__item { position: relative; aspect-ratio: 16/10; overflow: hidden; border-radius: 6px; background: var(--bg-2); }
  .strip__item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .strip__item:hover img { transform: scale(1.06); }
  .strip__item span { position: absolute; left: 10px; bottom: 8px; right: 10px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; text-shadow: 0 1px 8px rgba(0,0,0,0.8); }
  @media (max-width: 900px) { .strip { grid-template-columns: repeat(3, 1fr); } }
</style>
