---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import VideoBg from "../components/VideoBg.astro";
import { site } from "../data/site";

const interests = [
  {
    t: "Creative AI & agentics",
    d: "AI agents, agentic workflows and software prototyping: tools that earn their place inside production, built to complement people rather than replace them. This is where most of my work sits now.",
  },
  {
    t: "Convergent technology",
    d: "New workflows and experiences that cross screen, sound, experiential and production software, rather than sitting neatly in one of them.",
  },
  {
    t: "Virtual & realtime production",
    d: "Games engines in film, animation, experiential work and events technology, and what adaptive, participatory and personalised fan experiences become when you have them.",
  },
  {
    t: "Digital twins & live data",
    d: "City-scale 3D models joined to realtime data, and the visualisation work that makes a dataset legible. Sensors and tracking used to build interactive experiences a lot of people can be inside at once.",
  },
];

const schema = {
  "@type": "CollectionPage",
  name: "R&D and innovation programmes by Pete Woodbridge",
  mainEntity: { "@id": "#person" },
};
---
<Base
  title="R&D & Innovation Programmes"
  description="R&D and innovation programmes: £12m of programmes and projects developed and led, 50+ funded collaborations, MusicFutures, MediaCity and Dreamlab."
  image="/img/og/research.jpg"
  schema={schema}
>
  <section class="hero hero--short">
    <VideoBg src={u("/video/research.mp4")} poster={u("/video/research.jpg")} soft />
    <div class="container hero__inner">
      <h1 class="eyebrow">R&amp;D and innovation programmes</h1>
      <p class="display h-xl" style="margin:0">Programmes, labs &amp; funding</p>
      <p class="hero__sub">Over the years I have developed and led £12m of innovation programmes and projects, with 50+ funded R&amp;D collaborations between them. Today the work goes on through the Liverpool City Region cluster role and Dreamlab.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">Programmes</p>
        <h2 class="display h-md">Where the R&amp;D happened</h2>
      </div>
      <div class="prose" data-reveal>
        <p>Today I work with the Liverpool City Region's businesses, universities, investors and talent to grow its digital and technology sector. I'm also founder and CTO of <a href={u("/work/dreamlab")}>Dreamlab</a>, an R&amp;D lab and collective of 48+ experts; since 2024 we have helped over 100 businesses and freelancers.</p>
        <p>I was part of the team that helped the Liverpool City Region win the <a href={u("/work/musicfutures")}>MusicFutures Creative Cluster</a>, a £7.2m programme with 28 regional and national partners running over five years from 2025, and then led its R&amp;D and innovation.</p>
        <p>Before that I directed R&amp;D and innovation at the <a href={u("/work/mediacity")}>MediaCity Immersive Technologies Innovation Hub</a>, where we supported over 35 funded collaborations with industry and hundreds of business assists on a £3.2m accelerator programme.</p>
        <p>Since the early 2000s I have mostly been industry based, with spells as a senior researcher and academic. I have worked on research with the University of Liverpool's <a href="http://www.cava-research.org/" target="_blank" rel="noopener">Centre for Architecture and the Visual Arts</a> and at the <a href="https://www.ljmu.ac.uk/research/centres-and-institutes/institute-of-art-and-technology" target="_blank" rel="noopener">Institute of Art and Technology</a> at LJMU, where I co-ran the <a href={u("/work/xlab-ljmu")}>Experimental Technologies Lab</a> and we won grants from the AHRC, Innovate UK and commercial investors.</p>
        <p>From 2015 to 2018 my R&amp;D was mainly with Manchester's <a href={u("/work/soda")}>School of Digital Arts</a>, focused on immersive storytelling. Between 2010 and 2015 it sat within the <a href={u("/work/disruptive-media")}>Centre for Disruptive Media</a> at Coventry University, working on digital engagement with new media, digital publishing and digital storytelling.</p>
        <p>I have also sat on the <a href="https://web.archive.org/web/20201130020642/https://www.liverpoollep.org/growth-sectors/digital-creative/" target="_blank" rel="noopener">Liverpool LEP Digital Board</a>, the College of Experts at <a href="https://xrstories.co.uk/" target="_blank" rel="noopener">XR Stories</a> in York and review panels for innovation funding across the UK, and worked as an external bid reviewer and advisor for the <a href="https://www.ukri.org/councils/epsrc/" target="_blank" rel="noopener">EPSRC</a>, <a href="https://www.costarnetwork.co.uk/" target="_blank" rel="noopener">CoSTAR</a> and <a href="https://www.digicatapult.org.uk/" target="_blank" rel="noopener">Digital Catapult</a>.</p>
        <p>Most of my hands-on R&amp;D now is creative AI and agentic workflows, with <a href={u("/work/soundings")}>Soundings</a> the clearest example; for AI projects, see <a href={u("/ai")}>AI consultancy and prototyping</a>. Data made visible is the other thread: <a href={u("/experiments#electric-sheep-smart-city")}>Dreaming of Electric Sheep</a> built a digital twin of Liverpool, and <a href={u("/experiments#geospatial")}>Geospatial Data</a> put Google Maps inside Unreal Engine; for projects, see <a href={u("/digital-twins")}>digital twins, 3D city models and live data</a>.</p>
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="container">
      <p class="eyebrow" data-reveal>Funders</p>
      <h2 class="display h-md" data-reveal style="margin-bottom:1.2rem">Grants &amp; programmes</h2>
      <div class="chips" data-reveal>
        {site.funders.map((f) => <span class="chip chip--solid">{f}</span>)}
      </div>
    </div>
  </section>

  <section class="section inverted">
    <div class="container">
      <p class="eyebrow" data-reveal>Particularly interested in</p>
      <h2 class="display h-lg" data-reveal style="max-width: 16ch; margin-bottom: clamp(32px,4vw,64px)">Four things I keep coming back to.</h2>
      <div class="pillars stagger" data-reveal>
        {interests.map((p, i) => (
          <div class="pillar" style={`--i:${i}`}>
            <div class="pillar__num">0{i + 1}</div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--line cta">
    <div class="container">
      <h2 class="display h-lg" data-reveal>Got a programme in mind?</h2>
      <div class="cta__row" data-reveal>
        <p class="lead measure muted">R&amp;D collaborations, funding bids, programme design and technical feasibility. For businesses looking at AI, see <a href={u("/ai")}>AI consultancy &amp; prototyping</a>.</p>
        <a class="btn btn--volt" href={u("/contact")}>Talk about a programme <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
