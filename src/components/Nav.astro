---
import { u } from "../lib/url";
import { site } from "../data/site";
const path = Astro.url.pathname;
// `path` already includes the base path, so compare against the prefixed href.
const isActive = (href: string) => {
  const target = u(href).replace(/\/$/, "");
  const here = path.replace(/\/$/, "");
  return href === "/" ? here === target : here.startsWith(target);
};
---
<header class="nav" data-nav>
  <a class="nav__logo" href={u("/")} aria-label="Pete Woodbridge, home">
    <span>Pete</span><span>Woodbridge</span>
  </a>
  <nav class="nav__links" aria-label="Primary">
    {site.nav.map((n) => (
      <a href={u(n.href)} class:list={{ "is-active": isActive(n.href) }}>{n.label}</a>
    ))}
    <a class="nav__ext" href={site.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
  </nav>
  <button class="nav__burger" data-menu aria-label="Open menu" aria-expanded="false" aria-controls="menu">
    <span></span><span></span>
  </button>
</header>

<div class="menu" id="menu" data-menu-panel>
  <div class="menu__inner">
    <ul class="menu__list">
      <li><a href={u("/")} class="display">Home</a></li>
      {site.nav.map((n) => <li><a href={u(n.href)} class="display">{n.label}</a></li>)}
    </ul>
    <div class="menu__foot">
      <a href={site.linkedin} target="_blank" rel="noopener" class="btn btn--ghost">LinkedIn ↗</a>
      <p class="muted">{site.role}</p>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px var(--gutter);
    color: #fff;
    transition: padding 0.3s var(--ease), background 0.3s var(--ease), backdrop-filter 0.3s var(--ease);
  }
  /* scrim so the bar stays readable over light footage */
  .nav::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 150%; z-index: -1; pointer-events: none;
    background: linear-gradient(180deg, rgba(10, 10, 11, 0.85) 0%, rgba(10, 10, 11, 0.5) 45%, rgba(10, 10, 11, 0) 100%);
    transition: opacity 0.3s var(--ease);
  }
  .nav > * { position: relative; }
  .nav.is-scrolled { padding-block: 12px; background: rgba(10, 10, 11, 0.82); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .nav.is-scrolled::before { opacity: 0; }
  .nav__logo {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: -0.04em;
    font-size: 1.25rem; line-height: 0.85; display: flex; flex-direction: column;
  }
  .nav__links { display: flex; gap: clamp(18px, 2.4vw, 40px); align-items: center; font-weight: 600; font-size: 0.95rem; }
  .nav__links a { position: relative; padding-block: 4px; }
  .nav__links a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.3s var(--ease); }
  .nav__links a:hover::after, .nav__links a.is-active::after { transform: scaleX(1); }
  .nav__ext { opacity: 0.75; }
  .nav__burger { display: none; width: 44px; height: 44px; position: relative; }
  .nav__burger span { position: absolute; left: 10px; right: 10px; height: 2px; background: currentColor; transition: transform 0.3s var(--ease), top 0.3s var(--ease); }
  .nav__burger span:nth-child(1) { top: 17px; }
  .nav__burger span:nth-child(2) { top: 26px; }
  :global(body.menu-open) .nav__burger span:nth-child(1) { top: 21px; transform: rotate(45deg); }
  :global(body.menu-open) .nav__burger span:nth-child(2) { top: 21px; transform: rotate(-45deg); }
  @media (max-width: 800px) { .nav__links { display: none; } .nav__burger { display: block; } }

  .menu {
    position: fixed; inset: 0; z-index: 90; background: var(--bg);
    clip-path: inset(0 0 100% 0); transition: clip-path 0.6s var(--ease); visibility: hidden;
  }
  :global(body.menu-open) .menu { clip-path: inset(0 0 0 0); visibility: visible; }
  .menu__inner { height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 110px var(--gutter) 40px; }
  .menu__list a { font-size: clamp(3rem, 14vw, 6rem); display: block; padding-block: 0.05em; }
  .menu__list a:hover { color: var(--volt); }
  .menu__foot { display: flex; flex-direction: column; gap: 16px; }
</style>
