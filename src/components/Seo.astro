---
import { u } from "../lib/url";
import { site } from "../data/site";
import { ids, dreamlabOrg } from "../data/entities";

interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt?: string;
  type?: "website" | "profile" | "article";
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, image, imageAlt = title, type = "website", noindex = false, schema } = Astro.props;

// Astro.site comes from `site` in astro.config.mjs. Everything canonical is derived from it.
const base = Astro.site ?? new URL("http://localhost:4321");
// Always the trailing-slash form: it is the URL GitHub Pages actually serves (the bare one 301s).
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), base);
const ogImage = new URL(u(image), base);
const person = {
  "@type": "Person",
  // Fixed, not derived from the build URL: dreamlab.org.uk and getbearings.co.uk point at this exact @id.
  "@id": ids.person,
  name: site.name,
  alternateName: site.alternateNames,
  givenName: "Pete",
  familyName: "Woodbridge",
  url: base.toString(),
  // The homepage is the profile page about this Person.
  mainEntityOfPage: { "@id": new URL("/#profilepage", base).toString() },
  ...(site.portrait ? { image: new URL(u(site.portrait), base).toString() } : {}),
  jobTitle: [...site.jobTitles, "Founder & Chief Technical Officer, dreamlab"],
  description: site.description,
  worksFor: dreamlabOrg,
  // Profiles of Pete himself only. Organisations he works with go in `affiliation`,
  // because sameAs tells search engines "this is the same entity".
  sameAs: site.profiles,
  affiliation: [
    dreamlabOrg,
    ...site.affiliations.map((a) => ({ "@type": "Organization", name: a.name, url: a.url, description: a.role })),
  ],
  award: site.awards,
  address: { "@type": "PostalAddress", addressLocality: "Liverpool", addressRegion: "Merseyside", addressCountry: "GB" },
  homeLocation: { "@type": "Place", name: "Liverpool, United Kingdom" },
  workLocation: site.areasServed.map((a) => ({ "@type": "Place", name: a })),
  hasOccupation: ["AI Consultant", "Creative Technologist"].map((name) => ({
    "@type": "Occupation",
    name,
    occupationLocation: { "@type": "City", name: "Liverpool" },
    skills: site.expertise.join(", "),
  })),
  makesOffer: ["/ai#service", "/funding#service", "/digital-twins#service"].map((p) => ({ "@type": "Offer", itemOffered: { "@id": new URL(u(p), base).toString() } })),
  knowsAbout: [...new Set([...site.expertise, ...site.knowsAboutExtra])],
};
/** Schema.org wants absolute URLs. Resolve any "/path" or "#id" in url/item/@id/image/logo fields against the site root. */
const ABSOLUTE = new Set(["url", "item", "@id", "image", "logo"]);
function absolutise(node: unknown): unknown {
  if (Array.isArray(node)) return node.map(absolutise);
  if (node && typeof node === "object") {
    const out: Record<string, unknown> = {};
    for (const [k, v] of Object.entries(node as Record<string, unknown>)) {
      out[k] =
        ABSOLUTE.has(k) && typeof v === "string" && /^[/#]/.test(v)
          ? new URL(u(v), base).toString()
          : absolutise(v);
    }
    return out;
  }
  return node;
}

const graph = [
  person,
  {
    "@type": "WebSite",
    "@id": ids.website,
    url: base.toString(),
    name: site.name,
    description: site.description,
    publisher: { "@id": ids.person },
    about: { "@id": ids.person },
    inLanguage: "en-GB",
  },
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
// Serialised below with "<" escaped, so no string in the data can close the script tag early.
const jsonld = { "@context": "https://schema.org", "@graph": absolutise(graph) };
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex
  ? <meta name="robots" content="noindex, follow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<meta name="author" content={site.name} />
<link rel="sitemap" href={u("/sitemap-index.xml")} />

<script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, "\\u003c")} is:inline />
