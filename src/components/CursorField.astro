      if (variant === "orbits") { orbV = orbR.map((_, k) => (orbV[k] ?? 0) + (k % 2 ? -1 : 1) * 0.11 / (1 + k * 0.28)); wake(); return; }
      if (variant === "terrain") { scans.push(performance.now()); if (scans.length > 3) scans.shift(); wake(); return; }
      if (variant === "bars") { surges.push({ x: e.clientX, t: performance.now() }); if (surges.length > 3) surges.shift(); wake(); return; }
      if (variant === "cubes") { flips.push({ x: e.clientX, y: e.clientY, t: performance.now() }); if (flips.length > 3) flips.shift(); wake(); return; }
      if (variant === "glyphs") { typers.push({ x: e.clientX, y: e.clientY, t: performance.now() }); if (typers.length > 3) typers.shift(); wake(); return; }
      ripples.push({ x: e.clientX, y: e.clientY, t: performance.now() });
      if (ripples.length > 4) ripples.shift();
      wake();
    }, { passive: true, signal });
    const leave = () => { want = 0; if (live()) wake(); };
    document.addEventListener("mouseout", (e) => { if (!e.relatedTarget) leave(); }, { signal });
    window.addEventListener("blur", leave, { signal });
    document.addEventListener("motion:change", () => { if (!live()) still(); }, { signal });
    reduced.addEventListener("change", () => { if (!live()) still(); }, { signal });

    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    return () => { ac.abort(); ro.disconnect(); cancelAnimationFrame(raf); };
  }

  let teardown: (() => void) | undefined;
  const start = () => {
    teardown?.();
    const canvas = document.querySelector<HTMLCanvasElement>("[data-cursorfield]");
    teardown = canvas ? mount(canvas) : undefined;
  };
  document.addEventListener("astro:page-load", start);
  document.addEventListener("astro:before-swap", () => { teardown?.(); teardown = undefined; });
</script>
