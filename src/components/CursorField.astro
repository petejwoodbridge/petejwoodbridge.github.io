---
/** Page backdrops that answer the pointer: sister effects to the homepage's LedField, one per subject.
 *
 *  `links`   – a constellation. Points link up round the pointer, like a network waking. (AI, research)
 *  `grid`    – a survey grid. The lines bulge like a lens and crosshairs mark the nearest corners;
 *              with `coords` the pointer also reads out a latitude and longitude. (Digital twins, work)
 *  `needles` – a field of compass needles that swing to face the pointer. (Experiments, about, teaching)
 *  `wave`    – ruled lines that carry a waveform where the pointer is. (Speaking, events, press, contact)
 *
 *  All four share the LedField rules. At rest each is a barely-there texture in ink; near the pointer
 *  it brightens and tips into volt, a quick move leaves a short afterglow, a click sends one ripple.
 *  Touch screens, reduced motion and the nav's motion toggle get the still texture only, and the loop
 *  sleeps once everything has settled.
 *
 *  Place it like LedField: before the content it should sit behind (in a hero, straight after the
 *  VideoBg). It is fixed at z-index 0, so positioned sections after it in the page paint over it. */
interface Props {
  variant: "links" | "grid" | "needles" | "wave";
  /** `grid` only: show a latitude and longitude beside the pointer. */
  coords?: boolean;
}
const { variant, coords = false } = Astro.props;
---
<canvas class="cfield" data-cursorfield={variant} data-coords={coords ? "" : undefined} aria-hidden="true"></canvas>

<style>
  .cfield { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; display: block; }
</style>

<script>
  type Variant = "links" | "grid" | "needles" | "wave";
  // gx/gy: spacing. jitter: how far points stray from the grid. radius/lift: size and brightness of the
  // lit area. push: how far points part round the pointer (negative draws them in). base/peak: opacity
  // at rest and fully lit.
  const CFG: Record<Variant, { gx: number; gy: number; jitter: number; radius: number; lift: number; push: number; base: number; peak: number }> = {
    links:   { gx: 92, gy: 92, jitter: 0.36, radius: 270, lift: 0.55, push: -6, base: 0.13, peak: 0.9 },
    grid:    { gx: 56, gy: 56, jitter: 0,    radius: 260, lift: 0.45, push: 10, base: 0.05, peak: 0.6 },
    needles: { gx: 34, gy: 34, jitter: 0,    radius: 300, lift: 0.5,  push: 0,  base: 0.12, peak: 0.85 },
    wave:    { gx: 18, gy: 30, jitter: 0,    radius: 250, lift: 0.55, push: 0,  base: 0.065, peak: 0.75 },
  };
  const TRAIL_R = 110;     // reach of the afterglow either side of the pointer's path
  const DECAY = 0.94;      // afterglow kept per frame (about half a second to fade)
  const SPRING = 0.12, DAMP = 0.74;
  const RIPPLE_SPEED = 0.75, RIPPLE_LIFE = 1100, RIPPLE_W = 34; // px per ms, ms, px
  const LEVELS = 24;       // brightness steps; everything on one step is drawn in a single stroke
  const WAVE_AMP = 11, WAVE_K = 0.045;

  const smooth = (a: number, b: number, x: number) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
  const rgb = (v: string, fallback: number[]) => {
    const m = v.trim().match(/^#([0-9a-f]{6})$/i);
    if (!m) return fallback;
    const n = parseInt(m[1], 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  };
  // The same scatter every time for a given column and row, so a resize does not reshuffle the points.
  const scatter = (a: number, b: number) => { const s = Math.sin(a * 127.1 + b * 311.7) * 43758.5453; return s - Math.floor(s) - 0.5; };

  function mount(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    const variant = canvas.dataset.cursorfield as Variant;
    const cfg = CFG[variant];
    if (!ctx || !cfg) return () => {};
    const coords = canvas.dataset.coords !== undefined;
    const ac = new AbortController();
    const { signal } = ac;
    const root = document.documentElement;
    const css = getComputedStyle(root);
    const ink = rgb(css.getPropertyValue("--ink"), [243, 239, 230]);
    const volt = rgb(css.getPropertyValue("--volt"), [217, 255, 63]);
    const fine = matchMedia("(hover: hover) and (pointer: fine)");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const live = () => fine.matches && !reduced.matches && !root.classList.contains("no-motion");

    // Ink at rest, tipping into volt as things light up. `line` is for strokes that only exist when lit.
    const tone: string[] = [], line: string[] = [];
    for (let i = 0; i < LEVELS; i++) {
      const t = i / (LEVELS - 1);
      const m = smooth(0.2, 0.75, t);
      const c = ink.map((v, k) => Math.round(v + (volt[k] - v) * m)).join(",");
      tone[i] = `rgba(${c},${(cfg.base + (cfg.peak - cfg.base) * t).toFixed(3)})`;
      line[i] = `rgba(${c},${(0.8 * t).toFixed(3)})`;
    }

    let dpr = 1, w = 0, h = 0, cols = 0, rows = 0, n = 0;
    let x0 = new Float32Array(0), y0 = x0, offX = x0, offY = x0, velX = x0, velY = x0, glow = x0, lit = x0, ang = x0;
    let level = new Uint8Array(0), pairs = new Int32Array(0);

    // Pointer: tx/ty is where it is, px/py eases after it so the light glides rather than snaps.
    let tx = 0, ty = 0, px = 0, py = 0, travelled = 0, want = 0, presence = 0;
    const ripples: { x: number; y: number; t: number }[] = [];
    let raf = 0, last = 0;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      cols = Math.floor(w / cfg.gx) + 2; rows = Math.floor(h / cfg.gy) + 2; n = cols * rows;
      const ox = (w - (cols - 1) * cfg.gx) / 2, oy = (h - (rows - 1) * cfg.gy) / 2;
      x0 = new Float32Array(n); y0 = new Float32Array(n);
      for (let r = 0, i = 0; r < rows; r++) for (let c = 0; c < cols; c++, i++) {
        x0[i] = ox + c * cfg.gx + scatter(c, r) * cfg.gx * cfg.jitter * 2;
        y0[i] = oy + r * cfg.gy + scatter(r + 17, c + 5) * cfg.gy * cfg.jitter * 2;
      }
      offX = new Float32Array(n); offY = new Float32Array(n); velX = new Float32Array(n); velY = new Float32Array(n);
      glow = new Float32Array(n); lit = new Float32Array(n); ang = new Float32Array(n); level = new Uint8Array(n);
      if (variant === "links") {
        // Each point can link to its near neighbours; the pairs are worked out once per resize.
        const reach = cfg.gx * 1.42, list: number[] = [];
        for (let r = 0, i = 0; r < rows; r++) for (let c = 0; c < cols; c++, i++) {
          for (const [dc, dr] of [[1, 0], [0, 1], [1, 1], [-1, 1]]) {
            const cc = c + dc, rr = r + dr;
            if (cc < 0 || cc >= cols || rr >= rows) continue;
            const j = rr * cols + cc;
            if (Math.hypot(x0[i] - x0[j], y0[i] - y0[j]) < reach) list.push(i, j);
          }
        }
        pairs = Int32Array.from(list);
      }
      draw();
      if (live()) wake();
    }

    function draw() {
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.clearRect(0, 0, w, h);
      ctx!.lineWidth = 1;
      const P: (Path2D | undefined)[] = new Array(LEVELS);   // one path per brightness step
      const Q: (Path2D | undefined)[] = new Array(LEVELS);   // a second set, for lit-only strokes
      const at = (set: (Path2D | undefined)[], l: number) => (set[l] ??= new Path2D());

      if (variant === "links") {
        for (let k = 0; k < pairs.length; k += 2) {
          const a = pairs[k], b = pairs[k + 1], l = Math.min(level[a], level[b]);
          if (!l) continue;
          const p = at(Q, l);
          p.moveTo(x0[a] + offX[a], y0[a] + offY[a]); p.lineTo(x0[b] + offX[b], y0[b] + offY[b]);
        }
        for (let i = 0; i < n; i++) {
          const l = level[i], s = 2 + 2 * (l / (LEVELS - 1));
          at(P, l).rect(x0[i] + offX[i] - s / 2, y0[i] + offY[i] - s / 2, s, s);
        }
        for (let l = 1; l < LEVELS; l++) if (Q[l]) { ctx!.strokeStyle = line[l]; ctx!.stroke(Q[l]!); }
        for (let l = 0; l < LEVELS; l++) if (P[l]) { ctx!.fillStyle = tone[l]; ctx!.fill(P[l]!); }
      } else if (variant === "grid") {
        for (let r = 0, i = 0; r < rows; r++) for (let c = 0; c < cols; c++, i++) {
          const x = x0[i] + offX[i], y = y0[i] + offY[i];
          if (c + 1 < cols) { const j = i + 1, p = at(P, (level[i] + level[j]) >> 1); p.moveTo(x, y); p.lineTo(x0[j] + offX[j], y0[j] + offY[j]); }
          if (r + 1 < rows) { const j = i + cols, p = at(P, (level[i] + level[j]) >> 1); p.moveTo(x, y); p.lineTo(x0[j] + offX[j], y0[j] + offY[j]); }
          // crosshairs on the corners nearest the pointer
          if (level[i] > LEVELS * 0.38) { const q = at(Q, level[i]); q.moveTo(x - 4, y); q.lineTo(x + 4, y); q.moveTo(x, y - 4); q.lineTo(x, y + 4); }
        }
        for (let l = 0; l < LEVELS; l++) if (P[l]) { ctx!.strokeStyle = tone[l]; ctx!.stroke(P[l]!); }
        ctx!.lineWidth = 1.5;
        for (let l = 1; l < LEVELS; l++) if (Q[l]) { ctx!.strokeStyle = `rgba(${volt.join(",")},${(0.9 * l / (LEVELS - 1)).toFixed(3)})`; ctx!.stroke(Q[l]!); }
        if (coords && presence > 0.05) {
          // The window stands in for the Liverpool City Region: top-left is north-west.
          const lat = 53.52 - (py / h) * 0.24, lng = 3.12 - (px / w) * 0.42;
          const label = `${lat.toFixed(4)}° N   ${lng.toFixed(4)}° W`;
          ctx!.font = "500 10px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";
          (ctx as any).letterSpacing = "0.08em";
          const tw = ctx!.measureText(label).width;
          ctx!.fillStyle = `rgba(${ink.join(",")},${(0.62 * presence).toFixed(3)})`;
          ctx!.fillText(label, px + 20 + tw > w ? px - 20 - tw : px + 20, py + 34 > h ? py - 22 : py + 34);
        }
      } else if (variant === "needles") {
        ctx!.lineWidth = 1.25;
        for (let i = 0; i < n; i++) {
          const l = level[i], half = (3 + 10 * (l / (LEVELS - 1))) / 2, c = Math.cos(ang[i]) * half, s = Math.sin(ang[i]) * half;
          const p = at(P, l);
          p.moveTo(x0[i] - c, y0[i] - s); p.lineTo(x0[i] + c, y0[i] + s);
        }
        for (let l = 0; l < LEVELS; l++) if (P[l]) { ctx!.strokeStyle = tone[l]; ctx!.stroke(P[l]!); }
      } else {
        // wave: each ruled line lifts into a short waveform centred on the pointer
        const yAt = (i: number, r: number) => y0[i] + WAVE_AMP * lit[i] * Math.cos((x0[i] - px) * WAVE_K + r * 0.9);
        for (let r = 0, i = 0; r < rows; r++) {
          let prevY = yAt(i, r);
          for (let c = 0; c < cols; c++, i++) {
            if (c + 1 >= cols) continue;
            const nextY = yAt(i + 1, r), p = at(P, Math.max(level[i], level[i + 1]));
            p.moveTo(x0[i], prevY); p.lineTo(x0[i + 1], nextY);
            prevY = nextY;
          }
        }
        for (let l = 0; l < LEVELS; l++) if (P[l]) { ctx!.strokeStyle = tone[l]; ctx!.stroke(P[l]!); }
      }
    }

    function step(now: number) {
      raf = 0;
      const f = Math.min(4, (now - last) / 16.667 || 1);
      last = now;
      const ppx = px, ppy = py;
      const ease = 1 - Math.pow(0.7, f);
      px += (tx - px) * ease; py += (ty - py) * ease;
      presence += (want - presence) * (1 - Math.pow(0.9, f));
      // Only a quick move leaves an afterglow; drifting slowly just carries the light around.
      const inject = smooth(1.5, 28, travelled / f) * presence * 0.55 * f;
      travelled = 0;
      const decay = Math.pow(DECAY, f), damp = Math.pow(DAMP, f), turn = 1 - Math.pow(0.8, f);
      for (let r = ripples.length - 1; r >= 0; r--) if (now - ripples[r].t > RIPPLE_LIFE) ripples.splice(r, 1);

      const sx = px - ppx, sy = py - ppy, sl = sx * sx + sy * sy;
      const R = cfg.radius, R2 = R * R, T2 = TRAIL_R * TRAIL_R;
      let busy = false;
      for (let i = 0; i < n; i++) {
        const ex0 = x0[i], ey0 = y0[i];
        let spot = 0, aimX = 0, aimY = 0, kick = 0, kx = 0, ky = 0;

        const dx = ex0 - px, dy = ey0 - py, d2 = dx * dx + dy * dy;
        if (presence > 0.001 && d2 < R2) {
          const d = Math.sqrt(d2) || 1, k = 1 - d / R;
          spot = k * k * presence;
          aimX = (dx / d) * spot * cfg.push; aimY = (dy / d) * spot * cfg.push;
        }

        let e = glow[i] * decay;
        if (inject > 0) {
          // distance to the path the pointer took this frame, so a fast flick leaves no gaps
          let u = sl > 0 ? ((ex0 - ppx) * sx + (ey0 - ppy) * sy) / sl : 0;
          u = u < 0 ? 0 : u > 1 ? 1 : u;
          const qx = ex0 - ppx - sx * u, qy = ey0 - ppy - sy * u, q2 = qx * qx + qy * qy;
          if (q2 < T2) { const k = 1 - q2 / T2; e += k * k * inject; }
        }

        for (let r = 0; r < ripples.length; r++) {
          const rp = ripples[r], age = now - rp.t;
          const rx = ex0 - rp.x, ry = ey0 - rp.y, d = Math.sqrt(rx * rx + ry * ry) || 1;
          const band = (d - age * RIPPLE_SPEED) / RIPPLE_W;
          if (band > 3 || band < -3) continue;
          const k = Math.exp(-band * band) * (1 - age / RIPPLE_LIFE);
          if (k * 0.7 > e) e = k * 0.7;
          kick += k; kx += (rx / d) * k; ky += (ry / d) * k;
        }

        e = e > 1 ? 1 : e < 0.003 ? 0 : e;
        glow[i] = e;

        if (cfg.push) {
          let vx = (velX[i] + (aimX - offX[i]) * SPRING * f + kx * 0.9 * f) * damp;
          let vy = (velY[i] + (aimY - offY[i]) * SPRING * f + ky * 0.9 * f) * damp;
          if (vx < 0.004 && vx > -0.004 && vy < 0.004 && vy > -0.004 && !kick) {
            const ex = aimX - offX[i], ey = aimY - offY[i];
            if (ex < 0.05 && ex > -0.05 && ey < 0.05 && ey > -0.05) { vx = vy = 0; offX[i] = aimX; offY[i] = aimY; }
          }
          velX[i] = vx; velY[i] = vy;
          offX[i] += vx * f; offY[i] += vy * f;
          if (vx || vy) busy = true;
        }

        let t = spot * cfg.lift + e;
        t = t > 1 ? 1 : t;
        lit[i] = t;
        level[i] = Math.round(t * (LEVELS - 1));
        if (e) busy = true;

        if (variant === "needles") {
          // A needle has no head or tail, so it turns the short way round; unlit needles lie flat.
          let diff = (t > 0.02 ? Math.atan2(py - ey0, px - ex0) : 0) - ang[i];
          diff -= Math.PI * Math.round(diff / Math.PI);
          if (diff > 0.004 || diff < -0.004) { ang[i] += diff * turn; busy = true; }
        }
      }
      draw();
      const moving = Math.abs(tx - px) + Math.abs(ty - py) > 0.1 || Math.abs(want - presence) > 0.002;
      if (busy || moving || ripples.length) raf = requestAnimationFrame(step);
    }

    const wake = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(step); } };

    function still() {
      cancelAnimationFrame(raf); raf = 0;
      offX.fill(0); offY.fill(0); velX.fill(0); velY.fill(0); glow.fill(0); lit.fill(0); ang.fill(0); level.fill(0);
      want = presence = 0; ripples.length = 0;
      draw();
    }

    window.addEventListener("pointermove", (e) => {
      if (e.pointerType === "touch" || !live()) return;
      if (presence < 0.01 && want === 0) { tx = px = e.clientX; ty = py = e.clientY; }
      travelled += Math.hypot(e.clientX - tx, e.clientY - ty);
      tx = e.clientX; ty = e.clientY; want = 1;
      wake();
    }, { passive: true, signal });
    window.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "touch" || !live()) return;
      ripples.push({ x: e.clientX, y: e.clientY, t: performance.now() });
      if (ripples.length > 4) ripples.shift();
      wake();
    }, { passive: true, signal });
    const leave = () => { want = 0; if (live()) wake(); };
    document.addEventListener("mouseout", (e) => { if (!e.relatedTarget) leave(); }, { signal });
    window.addEventListener("blur", leave, { signal });
    document.addEventListener("motion:change", () => { if (!live()) still(); }, { signal });
    reduced.addEventListener("change", () => { if (!live()) still(); }, { signal });

    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    return () => { ac.abort(); ro.disconnect(); cancelAnimationFrame(raf); };
  }

  let teardown: (() => void) | undefined;
  const start = () => {
    teardown?.();
    const canvas = document.querySelector<HTMLCanvasElement>("[data-cursorfield]");
    teardown = canvas ? mount(canvas) : undefined;
  };
  document.addEventListener("astro:page-load", start);
  document.addEventListener("astro:before-swap", () => { teardown?.(); teardown = undefined; });
</script>
