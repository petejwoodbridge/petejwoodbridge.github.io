---
/** Pete's email as a link that address harvesters cannot read.
 *  The address is stored reversed and base64-encoded, here and in the built HTML, and is put
 *  back together in the browser. Without JavaScript the link stays a plain "Email me" label. */
interface Props {
  class?: string;
  /** Show the address itself as the link text once revealed; otherwise keep the label. */
  showAddress?: boolean;
  label?: string;
}
const { class: cls = "", showAddress = false, label = "Email me" } = Astro.props;
const ENCODED = "bW9jLmxpYW1nQGpwZWdkaXJiZG9vdw==";
---
<a class={cls} data-email={ENCODED} data-show={showAddress ? "" : undefined} href="#email" rel="nofollow">{label}</a>

<script>
  function revealEmails() {
    document.querySelectorAll<HTMLAnchorElement>("a[data-email]").forEach((a) => {
      const address = [...atob(a.dataset.email as string)].reverse().join("");
      a.href = `mailto:${address}`;
      if (a.dataset.show !== undefined) a.textContent = address;
    });
  }
  document.addEventListener("astro:page-load", revealEmails);
</script>
