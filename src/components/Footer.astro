---
import { u } from "../lib/url";
import { site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <p class="eyebrow">Get in touch</p>
        <p class="lead measure">Got an idea, a project or an opportunity to make the world a bit cooler than it is? I would love to hear about it.</p>
        <div class="btn-row" style="margin-top:1.4rem">
          <a class="btn btn--volt" href={u("/contact")}>Contact <span class="arrow">↗</span></a>
          <a class="btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn <span class="arrow">↗</span></a>
        </div>
      </div>
      <ul class="footer__links">
        <li><a href={u("/work")}>Work</a></li>
        <li><a href={u("/about")}>About</a></li>
        <li><a href={u("/contact")}>Contact</a></li>
        <li><a href={site.dreamMachine.newsletter} target="_blank" rel="noopener">Dream Machine newsletter ↗</a></li>
        <li><a href={site.dreamlab} target="_blank" rel="noopener">Dreamlab ↗</a></li>
      </ul>
    </div>
  </div>
  <div class="footer__mark" aria-hidden="true"><span class="wordmark">Pete Woodbridge</span></div>
  <div class="container footer__bottom">
    <span>© {year} {site.name}</span>
    <span class="muted">{site.role}</span>
    <span class="muted">{site.location}</span>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-top: clamp(56px, 8vw, 120px); overflow: hidden; }
  .footer__top { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: 48px; align-items: start; }
  .footer__links { display: flex; flex-direction: column; gap: 10px; font-weight: 600; padding-top: 2.4rem; }
  .footer__links a:hover { color: var(--volt); }
  .footer__mark { margin-top: clamp(48px, 7vw, 110px); padding-inline: var(--gutter); line-height: 0.8; }
  .footer__bottom { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding-block: 24px 32px; font-size: 0.85rem; border-top: 1px solid var(--line); margin-top: 24px; }
  @media (max-width: 800px) { .footer__top { grid-template-columns: 1fr; } .footer__links { padding-top: 0; } }
</style>
